<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:showIn="@layout/content_import_from_google_password_dialog">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/errorScrollView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/keyline_2"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@id/errorButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/keyline_5"
            android:paddingTop="@dimen/keyline_4"
            android:paddingBottom="@dimen/keyline_5">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/errorIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/passwords_import_128" />

            <com.duckduckgo.common.ui.view.text.DaxTextView
                android:id="@+id/errorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/keyline_5"
                android:breakStrategy="balanced"
                android:gravity="center_horizontal"
                android:text="@string/importPasswordsRedesignResultTitle"
                app:typography="h1" />

            <com.duckduckgo.common.ui.view.listitem.OneLineListItem
                android:id="@+id/errorRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/keyline_5"
                android:background="@drawable/autofill_import_results_container_background"
                app:leadingIcon="@drawable/cross_recolorable_24"
                app:primaryText="@string/importPasswordsProcessingResultDialogResultImportFailed" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/errorButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/keyline_5"
        android:paddingVertical="@dimen/keyline_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.duckduckgo.common.ui.view.button.DaxButtonPrimary
            android:id="@+id/errorDoneButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/importPasswordsProcessingResultDialogDoneButtonText"
            app:daxButtonSize="large" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
