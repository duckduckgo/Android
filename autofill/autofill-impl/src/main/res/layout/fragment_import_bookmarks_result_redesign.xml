<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/daxColorSurfaceTertiary">

    <Space
        android:id="@+id/resultTopSpace"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/resultScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/resultButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/resultTopSpace">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/keyline_5"
            android:paddingTop="20dp"
            android:paddingBottom="@dimen/keyline_5">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/resultIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/keyline_5"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                tools:srcCompat="@drawable/success_128" />

            <com.duckduckgo.common.ui.view.text.DaxTextView
                android:id="@+id/resultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:breakStrategy="balanced"
                android:gravity="center_horizontal"
                app:typography="h1"
                tools:text="@string/importBookmarksRedesignResultTitle" />

            <com.duckduckgo.common.ui.view.listitem.OneLineListItem
                android:id="@+id/resultRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/keyline_5"
                android:background="@drawable/autofill_import_results_container_background"
                tools:leadingIcon="@drawable/check_recolorable_24"
                tools:primaryText="Bookmarks imported: 110" />

            <com.duckduckgo.common.ui.view.text.DaxTextView
                android:id="@+id/resultSecondaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/keyline_4"
                android:paddingHorizontal="@dimen/keyline_4"
                android:text="@string/importBookmarksErrorGenericMessageSecondary"
                android:visibility="gone"
                app:textType="secondary"
                app:typography="body2"
                tools:visibility="visible" />

            <FrameLayout
                android:id="@+id/resultPromoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/resultButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/keyline_5"
        android:paddingTop="@dimen/keyline_4"
        android:paddingBottom="@dimen/keyline_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.duckduckgo.common.ui.view.button.DaxButtonPrimary
            android:id="@+id/resultDoneButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:daxButtonSize="large"
            tools:text="@string/done" />

        <com.duckduckgo.common.ui.view.button.DaxButtonSecondary
            android:id="@+id/resultDoneSecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/done"
            android:visibility="gone"
            app:daxButtonSize="large" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
