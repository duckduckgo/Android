<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:showIn="@layout/content_import_from_google_password_dialog">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/browserPromoScrollView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@id/browserPromoButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/keyline_5"
            android:paddingTop="20dp"
            android:paddingBottom="@dimen/keyline_5">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/browserPromoIllustration"
                android:layout_width="wrap_content"
                android:layout_height="96dp"
                android:importantForAccessibility="no"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                app:lottie_repeatCount="1" />

            <com.duckduckgo.common.ui.view.text.DaxTextView
                android:id="@+id/browserPromoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/keyline_5"
                android:breakStrategy="balanced"
                android:gravity="center_horizontal"
                android:text="@string/passwords_import_promo_in_browser_title"
                app:typography="h1" />

            <com.duckduckgo.common.ui.view.text.DaxTextView
                android:id="@+id/browserPromoSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/keyline_5"
                android:gravity="center_horizontal"
                android:text="@string/passwords_import_promo_subtitle"
                app:textType="secondary"
                app:typography="body1" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/browserPromoButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/keyline_5"
        android:paddingVertical="@dimen/keyline_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.duckduckgo.common.ui.view.button.DaxButtonPrimary
            android:id="@+id/browserPromoImportButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/importPasswordsChooseMethodDialogGpmButton"
            app:daxButtonSize="large" />

        <com.duckduckgo.common.ui.view.button.DaxButtonGhost
            android:id="@+id/browserPromoDeclineButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/keyline_1"
            android:text="@string/passwords_import_promo_in_browser_secondary_action_button"
            app:daxButtonSize="large" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
