<resources>

    <!-- True when the InfoPanel brand design update is on. Absent from the base themes, so it resolves to false. -->
    <attr name="daxRebrandInfoPanels" format="boolean" />

    <dimen name="rebrandTabSwitcherInfoPanelHorizontalMargin">6dp</dimen>

    <!-- Override AppCompat's popup panelBackground for panels created without XML attributes. -->
    <style name="Widget.DuckDuckGo.InfoPanel.Rebrand" parent="Widget.DuckDuckGo.InfoPanel">
        <item name="panelBackground">@drawable/info_panel_tooltip_background</item>
    </style>

    <style name="ThemeOverlay.Rebrand.InfoPanels" parent="">
        <item name="daxRebrandInfoPanels">true</item>
    </style>

</resources>
