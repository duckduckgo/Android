<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.DuckDuckGo.NextStepsCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/keyline_5"
        android:paddingTop="@dimen/keyline_4"
        android:paddingEnd="@dimen/keyline_5"
        android:paddingBottom="@dimen/keyline_5">

        <ImageView
            android:id="@+id/sectionIcon"
            android:layout_width="@dimen/nextStepsSectionIconSize"
            android:layout_height="@dimen/nextStepsSectionIconSize"
            android:importantForAccessibility="no"
            android:src="@drawable/arrow_circle_right_16"
            app:layout_constraintBottom_toBottomOf="@id/sectionTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/sectionTitle"
            app:tint="?attr/daxColorPrimaryIcon" />

        <com.duckduckgo.common.ui.view.text.DaxTextView
            android:id="@+id/sectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/keyline_1"
            android:layout_marginEnd="@dimen/keyline_2"
            app:layout_constraintBottom_toBottomOf="@id/closeButton"
            app:layout_constraintEnd_toStartOf="@id/closeButton"
            app:layout_constraintStart_toEndOf="@id/sectionIcon"
            app:layout_constraintTop_toTopOf="@id/closeButton"
            app:typography="h4"
            tools:text="Next Steps" />

        <ImageView
            android:id="@+id/closeButton"
            android:layout_width="@dimen/nextStepsCloseButtonSize"
            android:layout_height="@dimen/nextStepsCloseButtonSize"
            android:background="@drawable/background_next_steps_close_button"
            android:contentDescription="@string/closeButtonContentDescription"
            android:padding="@dimen/keyline_1"
            android:src="@drawable/ic_close_24_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/itemImage"
            android:layout_width="@dimen/nextStepsItemImageSize"
            android:layout_height="@dimen/nextStepsItemImageSize"
            android:layout_marginStart="@dimen/keyline_4"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@id/primaryAction"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sectionTitle" />

        <com.duckduckgo.common.ui.view.text.DaxTextView
            android:id="@+id/itemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/keyline_5"
            android:layout_marginEnd="@dimen/keyline_6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/itemImage"
            app:layout_constraintTop_toTopOf="@id/itemImage"
            app:layout_goneMarginStart="@dimen/keyline_4"
            app:typography="h3"
            tools:text="Browse privately by default" />

        <com.duckduckgo.common.ui.view.text.DaxTextView
            android:id="@+id/itemDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@id/itemTitle"
            app:layout_constraintStart_toStartOf="@id/itemTitle"
            app:layout_constraintTop_toBottomOf="@id/itemTitle"
            app:textType="secondary"
            app:typography="body2"
            tools:text="Search privately every time with DuckDuckGo as your default browser" />

        <com.duckduckgo.common.ui.view.button.DaxButtonBrand
            android:id="@+id/primaryAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/keyline_3"
            app:daxButtonSize="small"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/itemTitle"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@id/itemTitle"
            app:layout_constraintTop_toBottomOf="@id/itemDescription"
            tools:text="Set as Default" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
