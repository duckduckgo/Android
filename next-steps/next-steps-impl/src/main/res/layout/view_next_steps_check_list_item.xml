<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/keyline_1">

    <ImageView
        android:id="@+id/itemImage"
        android:layout_width="@dimen/nextStepsCheckListItemIconSize"
        android:layout_height="@dimen/nextStepsCheckListItemIconSize"
        android:importantForAccessibility="no" />

    <com.duckduckgo.common.ui.view.text.DaxTextView
        android:id="@+id/itemTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/nextStepsCheckListItemIconSpacing"
        android:layout_marginEnd="@dimen/keyline_4"
        android:layout_weight="1"
        app:typography="h4"
        tools:text="Set DuckDuckGo as your default browser" />

    <ImageView
        android:id="@+id/actionButton"
        android:layout_width="@dimen/nextStepsCheckListItemIconSize"
        android:layout_height="@dimen/nextStepsCheckListItemIconSize"
        android:background="@drawable/background_next_steps_check_list_action"
        android:importantForAccessibility="no"
        android:padding="@dimen/keyline_1"
        android:src="@drawable/ic_chevron_small_right_24" />

    <ImageView
        android:id="@+id/completedIcon"
        android:layout_width="@dimen/nextStepsCheckListItemIconSize"
        android:layout_height="@dimen/nextStepsCheckListItemIconSize"
        android:importantForAccessibility="no"
        android:src="@drawable/check_recolorable_24"
        android:visibility="gone" />

</LinearLayout>
