<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chatsItemContainer"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/keyline_4"
    android:paddingEnd="@dimen/keyline_4"
    tools:ignore="DeprecatedWidgetInXml, InvalidColorAttribute">

    <ImageView
        android:id="@+id/chatsItemIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/duck_ai_widget_circle_background_daynight"
        android:importantForAccessibility="no"
        android:padding="@dimen/keyline_2"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chat_24_daynight"
        android:tint="@color/duckAiWidgetOnContainerColor"
        tools:ignore="UseAppTint" />

    <TextView
        android:id="@+id/chatsItemTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/keyline_3"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/duckAiWidgetTextColor"
        android:textSize="16sp" />

</LinearLayout>
