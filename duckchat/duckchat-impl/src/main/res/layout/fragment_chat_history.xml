<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.duckduckgo.duckchat.impl.history.ChatHistoryFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Widget.DuckDuckGo.ToolbarTheme"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/daxColorToolbar">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/daxColorToolbar"
                android:theme="@style/Widget.DuckDuckGo.ToolbarTheme"
                app:popupTheme="@style/Widget.DuckDuckGo.PopUpOverflowMenu" />

            <com.duckduckgo.common.ui.view.SearchBarView
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/keyline_2"
                android:visibility="gone"
                app:clearActionContentDescription="@string/duck_ai_chat_history_search_clear_content_description"
                app:searchHint="@string/duck_ai_chat_history_search_hint"
                app:upActionContentDescription="@string/duck_ai_chat_history_search_close_content_description" />
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <include
        android:id="@+id/chatHistorySelectAll"
        layout="@layout/view_chat_history_select_all"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        tools:visibility="visible" />

    <com.duckduckgo.common.ui.view.divider.HorizontalDivider
        android:id="@+id/chatHistorySelectAllDivider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:defaultPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chatHistorySelectAll"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatHistoryList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chatHistorySelectAllDivider" />

    <com.duckduckgo.duckchat.impl.history.ChatHistoryEmptyStateView
        android:id="@+id/chatHistoryEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chatHistorySelectAllDivider" />

</androidx.constraintlayout.widget.ConstraintLayout>
