<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.DuckDuckGo.TabCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/keyline_2"
    app:cardCornerRadius="@dimen/mediumShapeCornerRadius">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/keyline_1">

        <ImageView
            android:id="@+id/favicon"
            android:layout_width="@dimen/listItemImageSmallSize"
            android:layout_height="@dimen/listItemImageSmallSize"
            android:layout_marginStart="@dimen/keyline_2"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/duck_ai_tab_icon_content_description"
            android:src="@drawable/ic_duck_ai_color_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/selectable_circular_ripple"
            android:contentDescription="@string/closeButtonContentDescription"
            android:padding="8dp"
            android:src="@drawable/ic_close_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/daxColorPrimaryIcon" />

        <ImageView
            android:id="@+id/selectionIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/keyline_2"
            android:contentDescription="@string/duck_ai_chat_history_row_unselected_content_description"
            android:src="@drawable/ic_shape_circle_24"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/favicon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/favicon" />

        <com.duckduckgo.common.ui.view.text.DaxTextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/keyline_2"
            android:layout_marginEnd="6dp"
            android:breakStrategy="simple"
            android:ellipsize="end"
            android:lines="1"
            android:maxLines="1"
            android:textIsSelectable="false"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@id/favicon"
            app:layout_constraintEnd_toStartOf="@id/selectionIndicator"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@id/favicon"
            app:layout_constraintTop_toTopOf="@id/favicon"
            app:typography="h5"
            tools:text="Explain quantum entanglement" />

        <!-- Same size as the host's screenshot preview, so the card lines up with other grid cells. -->
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gridItemPreviewHeight"
            android:layout_marginTop="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/favicon">

            <com.duckduckgo.common.ui.view.text.DaxTextView
                android:id="@+id/snippet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:padding="@dimen/keyline_2"
                android:visibility="gone"
                app:textType="secondary"
                app:typography="body2"
                tools:text="Quantum entanglement is a phenomenon where two particles share a state."
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/emptyLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/duckduckgo_duckai_96"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/voiceActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ai_chat_voice_24"
                android:visibility="gone"
                app:tint="?attr/daxColorAccentBlue" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
