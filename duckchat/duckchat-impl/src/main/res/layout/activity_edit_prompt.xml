<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/daxColorBackground"
    android:orientation="vertical">

    <include
        android:id="@+id/includeToolbar"
        layout="@layout/include_default_toolbar" />

    <ScrollView
        android:id="@+id/editPromptContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/editPromptWarningCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-16dp"
                    android:layout_marginBottom="@dimen/keyline_4"
                    app:cardBackgroundColor="?attr/daxColorSurface"
                    app:cardCornerRadius="@dimen/largeShapeCornerRadius"
                    app:cardElevation="1dp"
                    app:strokeColor="?attr/daxColorOmnibarAccent"
                    app:strokeWidth="@dimen/omnibarOutlineWidth"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/editPromptInputCard"
                    app:layout_constraintStart_toStartOf="@id/editPromptInputCard"
                    app:layout_constraintTop_toBottomOf="@id/editPromptInputCard">

                    <com.duckduckgo.common.ui.view.text.DaxTextView
                        android:id="@+id/editPromptWarning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_info_16"
                        android:drawableTint="?attr/daxColorSecondaryIcon"
                        android:drawablePadding="@dimen/keyline_2"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/keyline_4"
                        android:paddingTop="28dp"
                        android:paddingBottom="12dp"
                        android:text="@string/duck_ai_edit_prompt_lose_responses_warning"
                        app:textType="secondary"
                        app:typography="caption" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/editPromptInputCard"
                    android:theme="?attr/daxInputModeCardThemeOverlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/keyline_4"
                    app:cardBackgroundColor="?attr/daxColorWindow"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.duckduckgo.duckchat.impl.ui.nativeinput.views.NativeInputModeWidget
                        android:id="@+id/editPromptInput"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
