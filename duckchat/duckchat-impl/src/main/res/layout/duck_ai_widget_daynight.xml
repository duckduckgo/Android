<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/duckAiWidgetContainer"
    style="@style/Widget.DuckDuckGo.SearchWidgetContainer"
    android:layout_height="match_parent"
    android:background="@drawable/duck_ai_widget_background_daynight"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:ignore="DeprecatedWidgetInXml, InvalidColorAttribute">

    <LinearLayout
        android:id="@+id/promptBarContainer"
        style="@style/Widget.DuckDuckGo.DuckAiWidgetPromptBar"
        android:layout_marginStart="@dimen/keyline_4"
        android:layout_marginTop="@dimen/keyline_2"
        android:layout_marginEnd="@dimen/keyline_4"
        android:background="@drawable/duck_ai_widget_prompt_bar_background_daynight"
        android:elevation="8dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/promptBarDaxIcon"
            style="@style/Widget.DuckDuckGo.SearchWidgetDDGLogo"
            android:src="@drawable/ic_duck_ai_color_24"
            android:importantForAccessibility="no"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/promptBarHint"
            style="@style/Widget.DuckDuckGo.SearchWidgetInputBox"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/duckAiWidgetHint"
            android:textColor="@color/duckAiWidgetHintColor" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/keyline_4"
        android:paddingEnd="@dimen/keyline_4">

        <LinearLayout
            android:id="@+id/actionVoice"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/duck_ai_widget_pill_background_daynight"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/keyline_2"
            android:paddingEnd="@dimen/keyline_2">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:tint="@color/duckAiWidgetOnContainerColor"
                android:src="@drawable/ic_ai_chat_voice_24_daynight"
                tools:ignore="ContentDescription, UseAppTint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/keyline_2"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/duckAiWidgetVoiceAction"
                android:textColor="@color/duckAiWidgetOnContainerColor"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionCreateImage"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/keyline_2"
            android:background="@drawable/duck_ai_widget_pill_background_daynight"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/keyline_2"
            android:paddingEnd="@dimen/keyline_2">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:tint="@color/duckAiWidgetOnContainerColor"
                android:src="@drawable/ic_images_24_daynight"
                tools:ignore="ContentDescription, UseAppTint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/keyline_2"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/duckAiWidgetImageAction"
                android:textColor="@color/duckAiWidgetOnContainerColor"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionTakePhoto"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/keyline_2"
            android:background="@drawable/duck_ai_widget_pill_background_daynight"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/keyline_2"
            android:paddingEnd="@dimen/keyline_2">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:tint="@color/duckAiWidgetOnContainerColor"
                android:src="@drawable/ic_camera_24_daynight"
                tools:ignore="ContentDescription, UseAppTint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/keyline_2"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/duckAiWidgetCameraAction"
                android:textColor="@color/duckAiWidgetOnContainerColor"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/keyline_4"
        android:layout_marginTop="@dimen/keyline_3"
        android:layout_marginEnd="@dimen/keyline_4"
        android:background="@color/duckAiWidgetDividerColor" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/chatsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />

        <TextView
            android:id="@+id/chatsMessageEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/duckAiWidgetEmpty"
            android:textSize="14sp"
            android:textColor="@color/duckAiWidgetHintColor"
            android:visibility="gone" />

        <TextView
            android:id="@+id/chatsMessageUnavailable"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/duckAiWidgetUnavailable"
            android:textSize="14sp"
            android:textColor="@color/duckAiWidgetHintColor"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/chatsViewAllContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/keyline_4"
            android:layout_marginEnd="@dimen/keyline_4"
            android:background="@color/duckAiWidgetDividerColor" />

        <TextView
            android:id="@+id/chatsViewAll"
            android:layout_width="match_parent"
            android:layout_height="@dimen/keyline_7"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="@dimen/keyline_4"
            android:paddingEnd="@dimen/keyline_4"
            android:text="@string/duckAiChatHistoryViewAllChats"
            android:textColor="@color/duckAiWidgetTextColor"
            android:textSize="16sp" />

    </LinearLayout>

</LinearLayout>
