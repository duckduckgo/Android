<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Widget.DuckDuckGo.ToolbarTheme">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/daxColorToolbar"
            android:theme="@style/Widget.DuckDuckGo.ToolbarTheme"
            app:popupTheme="@style/Widget.DuckDuckGo.PopUpOverflowMenu" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.duckduckgo.common.ui.view.listitem.TwoLineListItem
                android:id="@+id/promoRecord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/devSettingsDuckAiPromoCampaignRecord" />

            <com.duckduckgo.common.ui.view.divider.HorizontalDivider
                android:id="@+id/setupSectionDivider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.duckduckgo.common.ui.view.listitem.TwoLineListItem
                android:id="@+id/setupSectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/devSettingsDuckAiPromoCampaignSetupSection"
                app:secondaryText="@string/devSettingsDuckAiPromoCampaignSetupSectionDescription" />

            <com.duckduckgo.common.ui.view.text.DaxTextInput
                android:id="@+id/campaignId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/keyline_4"
                android:hint="@string/devSettingsDuckAiPromoCampaignCampaignId"
                android:text="@string/devSettingsDuckAiPromoCampaignCampaignIdDefault"
                app:editable="true"
                app:type="single_line" />

            <com.duckduckgo.common.ui.view.button.DaxButtonPrimary
                android:id="@+id/seedPendingPromo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/keyline_3"
                android:layout_marginTop="@dimen/keyline_2"
                android:text="@string/devSettingsDuckAiPromoCampaignSeedPendingPromo" />

            <com.duckduckgo.common.ui.view.button.DaxButtonPrimary
                android:id="@+id/seedExpiredPromo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/keyline_3"
                android:layout_marginTop="@dimen/keyline_1"
                android:text="@string/devSettingsDuckAiPromoCampaignSeedExpiredPromo" />

            <com.duckduckgo.common.ui.view.button.DaxButtonPrimary
                android:id="@+id/dismissOffer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/keyline_3"
                android:layout_marginTop="@dimen/keyline_1"
                android:text="@string/devSettingsDuckAiPromoCampaignDismissOffer" />

            <com.duckduckgo.common.ui.view.divider.HorizontalDivider
                android:id="@+id/simulateSectionDivider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/keyline_2" />

            <com.duckduckgo.common.ui.view.listitem.TwoLineListItem
                android:id="@+id/simulateSectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/devSettingsDuckAiPromoCampaignSimulateSection"
                app:secondaryText="@string/devSettingsDuckAiPromoCampaignSimulateSectionDescription" />

            <com.duckduckgo.common.ui.view.button.DaxButtonSecondary
                android:id="@+id/activatePendingPromo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/keyline_3"
                android:text="@string/devSettingsDuckAiPromoCampaignActivatePendingPromo" />

            <com.duckduckgo.common.ui.view.button.DaxButtonSecondary
                android:id="@+id/endPromo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/keyline_3"
                android:layout_marginTop="@dimen/keyline_1"
                android:text="@string/devSettingsDuckAiPromoCampaignEndPromo" />

            <com.duckduckgo.common.ui.view.button.DaxButtonSecondary
                android:id="@+id/forceEndPromo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/keyline_3"
                android:layout_marginTop="@dimen/keyline_1"
                android:text="@string/devSettingsDuckAiPromoCampaignForceEndPromo" />

            <com.duckduckgo.common.ui.view.button.DaxButtonSecondary
                android:id="@+id/invalidatePromo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/keyline_3"
                android:layout_marginTop="@dimen/keyline_1"
                android:text="@string/devSettingsDuckAiPromoCampaignInvalidatePromo" />

            <com.duckduckgo.common.ui.view.divider.HorizontalDivider
                android:id="@+id/clearSectionDivider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/keyline_2" />

            <com.duckduckgo.common.ui.view.button.DaxButtonDestructive
                android:id="@+id/clearPromoRecord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/keyline_3"
                android:layout_marginTop="@dimen/keyline_2"
                android:text="@string/devSettingsDuckAiPromoCampaignClearRecord" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
