<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <ImageView
        android:id="@+id/quickSetupTwoLineSwitchRowIcon"
        android:layout_width="@dimen/listItemImageMediumSize"
        android:layout_height="@dimen/listItemImageMediumSize"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.duckduckgo.common.ui.view.text.DaxTextView
        android:id="@+id/quickSetupTwoLineSwitchRowPrimaryText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@id/quickSetupTwoLineSwitchRowSecondaryText"
        app:layout_constraintEnd_toStartOf="@id/quickSetupTwoLineSwitchRowSwitch"
        app:layout_constraintStart_toEndOf="@id/quickSetupTwoLineSwitchRowIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:typography="body1"
        tools:text="Primary text" />

    <com.duckduckgo.common.ui.view.text.DaxTextView
        android:id="@+id/quickSetupTwoLineSwitchRowSecondaryText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/quickSetupTwoLineSwitchRowPrimaryText"
        app:layout_constraintStart_toStartOf="@id/quickSetupTwoLineSwitchRowPrimaryText"
        app:layout_constraintTop_toBottomOf="@id/quickSetupTwoLineSwitchRowPrimaryText"
        app:textType="secondary"
        app:typography="body2"
        tools:text="Secondary text spanning more than a single line of the row" />

    <com.duckduckgo.common.ui.view.DaxSwitch
        android:id="@+id/quickSetupTwoLineSwitchRowSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</merge>
