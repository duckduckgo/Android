<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <com.duckduckgo.app.onboarding.ui.view.OnboardingDialogTitleView
        android:id="@+id/downloadReasonTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:text="@string/downloadReasonTitle" />

    <com.duckduckgo.common.ui.view.text.DaxTextView
        android:id="@+id/downloadReasonBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:alpha="0"
        android:gravity="center"
        android:includeFontPadding="false"
        app:typography="onboarding_body"
        tools:alpha="1"
        tools:text="@string/downloadReasonBody" />

    <LinearLayout
        android:id="@+id/downloadReasonOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:alpha="0"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        tools:alpha="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/downloadReasonOptionSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@null"
                app:cardBackgroundColor="@color/brand_design_tab_tile_background"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:cardForegroundColor="@android:color/transparent"
                app:cardPreventCornerOverlap="false"
                app:contentPadding="0dp"
                app:rippleColor="@android:color/transparent"
                app:strokeColor="@color/brand_design_tab_tile_stroke"
                app:strokeWidth="1dp"
                tools:ignore="InvalidColorAttribute">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="20dp">

                    <!--
                      Each pictogram reserves roughly a fifth of its canvas per side as motion headroom, so a 64dp
                      view is what draws the glyph at the ~44dp size a static icon would.
                    -->
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/downloadReasonOptionSearchIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:importantForAccessibility="no"
                        app:lottie_rawRes="@raw/onboarding_download_reason_search" />

                    <com.duckduckgo.common.ui.view.text.DaxTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/downloadReasonOptionSearch"
                        android:textAppearance="@style/Typography.DuckDuckGo.Onboarding.Body.InContext"
                        android:textColor="?attr/daxColorPrimaryText" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/downloadReasonOptionAiChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@null"
                app:cardBackgroundColor="@color/brand_design_tab_tile_background"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:cardForegroundColor="@android:color/transparent"
                app:cardPreventCornerOverlap="false"
                app:contentPadding="0dp"
                app:rippleColor="@android:color/transparent"
                app:strokeColor="@color/brand_design_tab_tile_stroke"
                app:strokeWidth="1dp"
                tools:ignore="InvalidColorAttribute">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="20dp">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/downloadReasonOptionAiChatIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:importantForAccessibility="no"
                        app:lottie_rawRes="@raw/onboarding_download_reason_ai_chat" />

                    <com.duckduckgo.common.ui.view.text.DaxTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/downloadReasonOptionAiChat"
                        android:textAppearance="@style/Typography.DuckDuckGo.Onboarding.Body.InContext"
                        android:textColor="?attr/daxColorPrimaryText" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/downloadReasonOptionNoAi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@null"
                app:cardBackgroundColor="@color/brand_design_tab_tile_background"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:cardForegroundColor="@android:color/transparent"
                app:cardPreventCornerOverlap="false"
                app:contentPadding="0dp"
                app:rippleColor="@android:color/transparent"
                app:strokeColor="@color/brand_design_tab_tile_stroke"
                app:strokeWidth="1dp"
                tools:ignore="InvalidColorAttribute">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="20dp">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/downloadReasonOptionNoAiIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:importantForAccessibility="no"
                        app:lottie_rawRes="@raw/onboarding_download_reason_no_ai" />

                    <com.duckduckgo.common.ui.view.text.DaxTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/downloadReasonOptionNoAi"
                        android:textAppearance="@style/Typography.DuckDuckGo.Onboarding.Body.InContext"
                        android:textColor="?attr/daxColorPrimaryText" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/downloadReasonOptionBlockAds"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@null"
                app:cardBackgroundColor="@color/brand_design_tab_tile_background"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:cardForegroundColor="@android:color/transparent"
                app:cardPreventCornerOverlap="false"
                app:contentPadding="0dp"
                app:rippleColor="@android:color/transparent"
                app:strokeColor="@color/brand_design_tab_tile_stroke"
                app:strokeWidth="1dp"
                tools:ignore="InvalidColorAttribute">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="20dp">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/downloadReasonOptionBlockAdsIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:importantForAccessibility="no"
                        app:lottie_rawRes="@raw/onboarding_download_reason_block_ads" />

                    <com.duckduckgo.common.ui.view.text.DaxTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/downloadReasonOptionBlockAds"
                        android:textAppearance="@style/Typography.DuckDuckGo.Onboarding.Body.InContext"
                        android:textColor="?attr/daxColorPrimaryText" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
