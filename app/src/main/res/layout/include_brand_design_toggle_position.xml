<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/keyline_4"
    android:orientation="vertical">

    <com.duckduckgo.app.onboarding.ui.view.OnboardingDialogTitleView
        android:id="@+id/togglePositionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/keyline_6"
        android:layout_marginEnd="@dimen/keyline_6" />

    <LinearLayout
        android:id="@+id/togglePositionContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:alpha="0"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/togglePositionPictogram"
            android:layout_width="128dp"
            android:layout_height="80dp"
            android:importantForAccessibility="no"
            android:src="@drawable/toggle_ai_chat_default_lighttheme" />

        <com.duckduckgo.common.ui.view.text.DaxTextView
            android:id="@+id/togglePositionPictogramCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="?attr/onboardingTextSecondarySmall"
            android:includeFontPadding="false"
            app:typography="onboarding_small_text" />

    </LinearLayout>

</LinearLayout>
