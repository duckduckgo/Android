<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_brand_design_single_choice_row"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/singleChoiceRowIcon"
        android:layout_width="@dimen/listItemImageMediumSize"
        android:layout_height="@dimen/listItemImageMediumSize"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.duckduckgo.common.ui.view.text.DaxTextView
        android:id="@+id/singleChoiceRowPrimaryText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_goneMarginStart="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/singleChoiceRowRadioButton"
        app:layout_constraintStart_toEndOf="@id/singleChoiceRowIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:typography="body1"
        tools:text="Primary text" />

    <com.duckduckgo.common.ui.view.button.RadioButton
        android:id="@+id/singleChoiceRowRadioButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null"
        android:clickable="false"
        android:focusable="false"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        app:buttonTint="@color/onboarding_radio_button_tint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="DeprecatedWidgetInXml,InvalidColorAttribute" />

</androidx.constraintlayout.widget.ConstraintLayout>
