<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/importCompletePictogram"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/keyline_4"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_passwords_import_96"
        tools:alpha="1"
        tools:src="@drawable/ic_success_96" />

    <com.duckduckgo.app.onboarding.ui.view.OnboardingDialogTitleView
        android:id="@+id/importCompleteTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/keyline_3"
        android:text="@string/preOnboardingImportCompleteTitle" />

    <com.duckduckgo.common.ui.view.text.DaxTextView
        android:id="@+id/importCompleteBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/keyline_2"
        android:alpha="0"
        android:fontFamily="@font/ducksansproduct_regular"
        android:gravity="center"
        android:paddingHorizontal="@dimen/keyline_3"
        app:textType="secondary"
        app:typography="body2"
        tools:alpha="1"
        tools:text="@string/preOnboardingImportCompleteParsingBody" />

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/importCompleteShimmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:alpha="0"
        android:visibility="gone"
        tools:alpha="1"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/keyline_4"
            android:layout_marginEnd="@dimen/keyline_4"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/list_item_image_circular_background"
                android:importantForAccessibility="no" />

            <com.duckduckgo.common.ui.view.SkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/keyline_4"
                android:layout_marginEnd="64dp" />

        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

    <LinearLayout
        android:id="@+id/importCompleteResultContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:alpha="0"
        android:background="@drawable/background_onboarding_import_result"
        android:orientation="vertical"
        android:visibility="gone"
        tools:alpha="1"
        tools:visibility="visible">

        <include
            android:id="@+id/importCompleteImportedRow"
            layout="@layout/include_brand_design_import_result_row"
            android:visibility="gone"
            tools:visibility="visible" />

        <include
            android:id="@+id/importCompleteSkippedRow"
            layout="@layout/include_brand_design_import_result_row"
            android:visibility="gone"
            tools:visibility="visible" />

        <include
            android:id="@+id/importCompleteFailedRow"
            layout="@layout/include_brand_design_import_result_row"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</LinearLayout>
