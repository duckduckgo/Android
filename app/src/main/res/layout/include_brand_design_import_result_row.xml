<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/oneLineItemHeight"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/keyline_3">

    <ImageView
        android:id="@+id/resultRowIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        tools:srcCompat="@drawable/ic_cross_recolorable_gray_24" />

    <com.duckduckgo.common.ui.view.text.DaxTextView
        android:id="@+id/resultRowText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/keyline_3"
        android:layout_weight="1"
        android:fontFamily="@font/ducksansproduct_regular"
        app:typography="body1"
        tools:text="@string/preOnboardingImportCompleteImported" />

</LinearLayout>
