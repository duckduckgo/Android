<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/keyline_4"
    android:orientation="vertical">

    <com.duckduckgo.app.onboarding.ui.view.OnboardingDialogTitleView
        android:id="@+id/singleChoiceTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/keyline_6"
        android:layout_marginEnd="@dimen/keyline_6" />

    <LinearLayout
        android:id="@+id/singleChoiceContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:alpha="0"
        android:orientation="vertical">

        <com.duckduckgo.common.ui.view.text.DaxTextView
            android:id="@+id/singleChoiceBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            app:typography="onboarding_body" />

        <LinearLayout
            android:id="@+id/radioButtonRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="4dp"
            android:orientation="vertical" />

    </LinearLayout>

</LinearLayout>
