<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/onboardingAccentAltGlowSecondary" />
            <stroke
                android:width="1dp"
                android:color="?attr/onboardingAccentPrimary" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/onboardingAccentAltGlowSecondary" />
            <stroke
                android:width="1dp"
                android:color="?attr/onboardingAccentPrimary" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/onboardingSurfaceTertiary" />
            <stroke
                android:width="1dp"
                android:color="?attr/onboardingSurfaceDecorationPrimary" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
