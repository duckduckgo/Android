<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.duckduckgo.common.ui.view.listitem.SettingsListItem
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:indicatorStatus="on"
        app:leadingIcon="@drawable/ic_dax_icon"
        app:primaryText="Privacy Protection" />

    <com.duckduckgo.common.ui.view.listitem.SettingsListItem
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:indicatorStatus="on"
        app:leadingIcon="@drawable/ic_dax_icon"
        app:pillIcon="true"
        app:pillText="Beta"
        app:primaryText="A long privacy setting label that wraps safely" />
</LinearLayout>
