<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.duckduckgo.common.ui.view.text.DaxTextInput
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="Display name"
        android:text="Ada"
        app:type="single_line" />

    <com.duckduckgo.common.ui.view.text.DaxTextInput
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="Notes"
        android:text="Line one&#10;Line two"
        app:type="multi_line" />

    <com.duckduckgo.common.ui.view.text.DaxTextInput
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="About you"
        android:text="A short bio"
        app:type="form_mode" />

    <com.duckduckgo.common.ui.view.text.DaxTextInput
        android:id="@+id/quizTextFieldError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="Email"
        android:text="not-an-email"
        app:type="single_line" />

    <com.duckduckgo.common.ui.view.text.DaxTextInput
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:enabled="false"
        android:hint="Disabled field"
        android:text="Unavailable"
        app:type="single_line" />

    <com.duckduckgo.common.ui.view.text.DaxTextInput
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Share link"
        android:text="https://duckduckgo.com"
        app:editable="false"
        app:endIcon="@drawable/ic_copy_24"
        app:endIconContentDescription="Copy link"
        app:type="single_line" />
</LinearLayout>
