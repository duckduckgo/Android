<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/includeToolbar"
        layout="@layout/include_default_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/keyline_4">

            <com.duckduckgo.common.ui.view.listitem.OneLineListItem
                android:id="@+id/enabledToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/newTabTransitionDevSettingsEnabled"
                app:showSwitch="true" />

            <com.duckduckgo.common.ui.view.text.DaxTextView
                android:id="@+id/swipingTabsNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/keyline_4"
                android:paddingBottom="@dimen/keyline_2"
                android:text="@string/newTabTransitionDevSettingsSwipingTabsNote"
                app:typography="body2" />

            <com.duckduckgo.common.ui.view.listitem.TwoLineListItem
                android:id="@+id/browserOriginSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/newTabTransitionDevSettingsBrowserOrigin" />

            <com.duckduckgo.common.ui.view.listitem.TwoLineListItem
                android:id="@+id/tabManagerOriginSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/newTabTransitionDevSettingsTabManagerOrigin" />

            <com.duckduckgo.common.ui.view.listitem.TwoLineListItem
                android:id="@+id/belowCenterSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/newTabTransitionDevSettingsBelowCenter"
                app:secondaryText="@string/newTabTransitionDevSettingsOriginSubtitle" />

            <com.duckduckgo.common.ui.view.listitem.TwoLineListItem
                android:id="@+id/rightOfCenterSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/newTabTransitionDevSettingsRightOfCenter"
                app:secondaryText="@string/newTabTransitionDevSettingsOriginSubtitle" />

            <com.duckduckgo.common.ui.view.listitem.OneLineListItem
                android:id="@+id/animateTabManagerOutToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/newTabTransitionDevSettingsAnimateTabManagerOut"
                app:showSwitch="true" />

            <com.duckduckgo.common.ui.view.listitem.OneLineListItem
                android:id="@+id/animateCloseToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/newTabTransitionDevSettingsAnimateClose"
                app:showSwitch="true" />

            <com.duckduckgo.common.ui.view.listitem.OneLineListItem
                android:id="@+id/slowMotionToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/newTabTransitionDevSettingsSlowMotion"
                app:showSwitch="true" />

            <com.duckduckgo.common.ui.view.button.DaxButtonSecondary
                android:id="@+id/resetButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/keyline_4"
                android:layout_marginTop="@dimen/keyline_2"
                android:text="@string/newTabTransitionDevSettingsReset"
                app:daxButtonSize="large" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
