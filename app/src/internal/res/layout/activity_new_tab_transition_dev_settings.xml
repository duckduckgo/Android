<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/includeToolbar"
        layout="@layout/include_default_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.duckduckgo.common.ui.view.listitem.OneLineListItem
                android:id="@+id/transitionOverrideToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/newTabTransitionDevSettingsOverride"
                app:showSwitch="true" />

            <com.duckduckgo.common.ui.view.text.DaxTextView
                android:id="@+id/swipingTabsNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/keyline_4"
                android:paddingBottom="@dimen/keyline_2"
                android:text="@string/newTabTransitionDevSettingsSwipingTabsNote"
                android:visibility="gone"
                app:typography="body2" />

            <com.duckduckgo.common.ui.view.listitem.TwoLineListItem
                android:id="@+id/transitionSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/newTabTransitionDevSettingsTransition" />

            <com.duckduckgo.common.ui.view.listitem.TwoLineListItem
                android:id="@+id/containerSourceSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:primaryText="@string/newTabTransitionDevSettingsContainerSource" />

            <com.duckduckgo.common.ui.view.listitem.TwoLineListItem
                android:id="@+id/containerStartSizeSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:primaryText="@string/newTabTransitionDevSettingsContainerStartSize" />

            <com.duckduckgo.common.ui.view.listitem.OneLineListItem
                android:id="@+id/containerRoundedCornersToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:primaryText="@string/newTabTransitionDevSettingsContainerRoundedCorners"
                app:showSwitch="true" />

            <com.duckduckgo.common.ui.view.listitem.OneLineListItem
                android:id="@+id/animateClosingTabsToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/newTabTransitionDevSettingsAnimateClosingTabs"
                app:showSwitch="true" />

            <com.duckduckgo.common.ui.view.listitem.TwoLineListItem
                android:id="@+id/tabManagerCloseSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/newTabTransitionDevSettingsTabManagerClose" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
