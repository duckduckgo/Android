<resources>
    <!-- Onboarding body (DuckSans product) at the 14sp the design calls for; no design-system style pairs the two. -->
    <style name="Typography.DuckDuckGo.CookiePopupOptIn.Hint" parent="Typography.DuckDuckGo.Onboarding.Body">
        <item name="android:textSize">14sp</item>
    </style>

    <!-- No design-system typography pairs 12sp all-caps with the semibold weight the design calls for. -->
    <style name="Typography.DuckDuckGo.CookiePopupOptIn.Brand" parent="Typography.DuckDuckGo.Caption.AllCaps">
        <item name="android:fontFamily">@font/ducksansproduct_medium</item>
    </style>

    <!--
      Declared on the activity so the platform keeps drawing the activity behind it: the sheet's rounded
      top corners show the browser through. DuckDuckGoActivity re-applies the user's light/dark theme at
      runtime, so only the manifest-parsed translucency flag survives from here; the window background is
      cleared in code.
      -->
    <style name="Theme.DuckDuckGo.CookiePopupOptIn" parent="Theme.DuckDuckGo.Light">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
