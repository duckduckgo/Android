<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="autoconsentTitle">Küpsiste hüpikakna kaitse</string>
    <string name="autoconsentDescription"><![CDATA[DuckDuckGo proovib valida kõige privaatsemad saadaolevad seaded ja peita need hüpikaknad sinu eest.\n<a href=\"\">Loe edasi</a>]]></string>
    <string name="autoconsentToggle">Lase DuckDuckGol küpsiste hüpikaknaid hallata</string>
    <string name="autoconsentAutoManageToggle">Keeldu valikulistest küpsistest</string>
    <string name="autoconsentAutoManageDescription">Püüame sinu jaoks blokeerida nii palju küpsiseid kui võimalik, seejärel sulgeda hüpikaknad.</string>
    <string name="autoconsentCookiePopUpPreferenceHeaderDescription"><![CDATA[DuckDuckGo saab automaatselt hallata küpsiste hüpikaknaid, et maksimeerida privaatsust ja minimeerida küpsiseid juba enne, kui neid näete.\n<a href=\"\">Loe edasi</a>]]></string>
    <string name="autoconsentPopUpsWithoutOptOutsToggle">Nõustu küpsistega, millest ei saa loobuda</string>
    <string name="autoconsentPopUpsWithoutOptOutsDescription">Kui keeldumisvõimalust pole, säästame sulle ühe klõpsu, nõustume sinu eest nende küpsistega ja sulgeme hüpikaknad.</string>
    <string name="autoconsentPromptTitle">Oled väsinud küpsiste hüpikakendest?</string>
    <string name="autoconsentPromptFootnote">Saad seda hiljem alati seadetes muuta.</string>
    <string name="autoconsentPromptCpmOnMessage">Mõnest küpsisest ei saa loobuda. Saame nõustuda nendega sinu eest.</string>
    <string name="autoconsentPromptCpmOnPrimaryButton">Nõustu küpsistega minu eest</string>
    <string name="autoconsentPromptCpmOnSecondaryButton">Ma nõustun nendega ise</string>
    <string name="autoconsentPromptCpmOffMessage">Me tegeleme nendega sinu eest. Võimalusel keeldume küpsistest ja nõustume nendega, millest ei saa loobuda.</string>
    <string name="autoconsentPromptCpmOffPrimaryButton">Keeldu võimalusel või nõustu minu eest</string>
    <string name="autoconsentPromptCpmOffSecondaryButton">Ma tegelen nendega ise</string>
</resources>
