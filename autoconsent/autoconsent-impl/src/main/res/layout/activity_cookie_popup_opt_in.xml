<!--
  The onboarding theme overlay is required: the bubble and the option row backgrounds resolve
  ?attr/onboarding* colors, and the bubble's own fallback keys off uiMode rather than the app theme.
  -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cookiePopupOptInContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/ThemeOverlay.DuckDuckGo.Onboarding">

    <!--
      The sheet surface is a sibling rather than the root's own background: the root takes the status bar
      inset as padding, so only a padded child can start below the bar and show its rounded corners.
      -->
    <View
        android:id="@+id/cookiePopupOptInSheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/background_cookie_popup_sheet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/cookiePopupOptInIllustration"
        android:layout_width="0dp"
        android:layout_height="@dimen/cookiePopupOptInIllustrationHeight"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/onboarding_input_type_background" />

    <!--
      Fills the sheet: the bubble is meant to float over the illustration, so reserving the illustration's
      height would push the content past the viewport and leave it scrollable on a screen it fits.
      Scrolls only when it genuinely doesn't fit - a large font scale or a short screen.
      -->
    <ScrollView
        android:id="@+id/cookiePopupOptInScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/keyline_5">

            <ImageView
                android:id="@+id/cookiePopupOptInLogo"
                android:layout_width="@dimen/cookiePopupOptInLogoSize"
                android:layout_height="@dimen/cookiePopupOptInLogoSize"
                android:layout_marginTop="@dimen/keyline_6"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_duckduckgo_color_24" />

            <com.duckduckgo.common.ui.view.DaxYellowPill
                android:id="@+id/cookiePopupOptInNewBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/keyline_4"
                android:text="@string/autoconsentPopupNewBadge"
                app:layout_constraintEnd_toStartOf="@id/cookiePopupOptInBrand"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cookiePopupOptInLogo" />

            <com.duckduckgo.common.ui.view.text.DaxTextView
                android:id="@+id/cookiePopupOptInBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/keyline_2"
                android:text="@string/autoconsentPopupBrand"
                app:layout_constraintBottom_toBottomOf="@id/cookiePopupOptInNewBadge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cookiePopupOptInNewBadge"
                app:layout_constraintTop_toTopOf="@id/cookiePopupOptInNewBadge"
                app:textType="secondary"
                app:typography="caption_allCaps" />

            <com.duckduckgo.common.ui.view.shape.DaxOnboardingBubbleBrandDesignUpdateCardView
                android:id="@+id/cookiePopupOptInBubble"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/keyline_4"
                android:layout_marginTop="@dimen/keyline_5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cookiePopupOptInNewBadge"
                app:showArrow="false">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/cookiePopupOptInCardPadding"
                    android:paddingTop="@dimen/keyline_6"
                    android:paddingBottom="@dimen/cookiePopupOptInCardPadding">

                    <ImageView
                        android:id="@+id/cookiePopupOptInPictogram"
                        android:layout_width="@dimen/cookiePopupOptInPictogramSize"
                        android:layout_height="@dimen/cookiePopupOptInPictogramSize"
                        android:importantForAccessibility="no"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/cookie_popups_check_96" />

                    <com.duckduckgo.common.ui.view.text.DaxTextView
                        android:id="@+id/cookiePopupOptInTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/keyline_4"
                        android:gravity="center_horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cookiePopupOptInPictogram"
                        app:typography="onboarding_title"
                        tools:text="@string/autoconsentPopupTitleWithFeatureEnabled" />

                    <com.duckduckgo.common.ui.view.text.DaxTextView
                        android:id="@+id/cookiePopupOptInDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cookiePopupOptInSectionSpacing"
                        android:gravity="center_horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cookiePopupOptInTitle"
                        app:typography="onboarding_body"
                        tools:text="@string/autoconsentPopupDescriptionWithFeatureEnabled" />

                    <include
                        android:id="@+id/cookiePopupOptInMaxOption"
                        layout="@layout/include_cookie_popup_opt_in_option"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cookiePopupOptInSectionSpacing"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cookiePopupOptInDescription" />

                    <include
                        android:id="@+id/cookiePopupOptInKeepCurrentOption"
                        layout="@layout/include_cookie_popup_opt_in_option"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/keyline_4"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cookiePopupOptInMaxOption" />

                    <com.duckduckgo.common.ui.view.button.DaxButtonPrimary
                        android:id="@+id/cookiePopupOptInConfirmButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cookiePopupOptInSectionSpacing"
                        android:text="@string/autoconsentPopupConfirmButton"
                        app:daxButtonSize="small"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cookiePopupOptInKeepCurrentOption" />

                    <com.duckduckgo.common.ui.view.text.DaxTextView
                        android:id="@+id/cookiePopupOptInSettingsHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cookiePopupOptInSectionSpacing"
                        android:gravity="center_horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cookiePopupOptInConfirmButton"
                        app:textType="secondary"
                        tools:text="@string/autoconsentPopupSettingsHint" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.duckduckgo.common.ui.view.shape.DaxOnboardingBubbleBrandDesignUpdateCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
