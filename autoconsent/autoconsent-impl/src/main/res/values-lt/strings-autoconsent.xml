    <string name="autoconsentCookiePopUpPreferenceHeaderDescription"><![CDATA[„DuckDuckGo“ gali automatiškai tvarkyti slapukų iškylančiuosius langus, kad užtikrintų maksimalų privatumą ir sumažintų slapukų skaičių tau jų net nepamačius.\n<a href=\"\">Sužinoti daugiau</a>]]></string>
