    <string name="autoconsentDescription"><![CDATA[„DuckDuckGo“ stengsis pasirinkti didžiausią privatumą užtikrinančius nustatymus ir paslėpti šiuos iškylančiuosius langus.\n<a href=\"\">Sužinoti daugiau</a>]]></string>
