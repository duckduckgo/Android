<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      translate-kit-android is minSdk 28, higher than this app's minSdk. The feature is hard-gated
      at runtime to never load the native library below API 28 (see RealTranslator), so we override
      the merged minSdk to keep the manifest merger from rejecting the library on lower-API builds.
    -->
    <uses-sdk tools:overrideLibrary="io.github.marcosholgado.translatekit" />

</manifest>
