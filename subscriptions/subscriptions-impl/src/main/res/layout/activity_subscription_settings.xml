<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/daxColorSurface"
    android:orientation="vertical"
    tools:context="com.duckduckgo.subscriptions.impl.ui.SubscriptionSettingsActivity">

    <include
        android:id="@+id/includeToolbar"
        layout="@layout/include_default_toolbar" />

    <ScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/keyline_5">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/keyline_4"
                android:importantForAccessibility="no"
                android:src="@drawable/subscription_128" />

            <com.duckduckgo.common.ui.view.text.DaxTextView
                android:id="@+id/subscriptionSettingsProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/keyline_2"
                android:layout_marginBottom="@dimen/keyline_2"
                app:textType="primary"
                app:typography="h2"
                tools:text="@string/privacyPro" />

            <LinearLayout
                android:id="@+id/subscriptionExpiredStatusContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/subscriptionExpiredStatusIconContentDescription"
                    android:src="@drawable/ic_exclamation_recolorable_16" />

                <com.duckduckgo.common.ui.view.text.DaxTextView
                    android:id="@+id/subscriptionExpiredStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:textType="secondary"
                    app:typography="body2"
                    tools:text="Your subscription expired on April 20, 2027." />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/subscriptionActiveStatusContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/subscriptionActiveStatusIconContentDescription"
                    android:padding="1dp"
                    android:src="@drawable/ic_dot_green" />

                <com.duckduckgo.common.ui.view.text.DaxTextView
                    android:id="@+id/subscriptionActiveStatusTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:textType="secondary"
                    app:typography="body2"
                    tools:text="@string/subscriptionStatusSubscribed" />

                <com.duckduckgo.common.ui.view.divider.VerticalDivider
                    android:id="@+id/verticalTierDivider"
                    android:layout_width="wrap_content"
                    android:layout_height="6dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/keyline_3"
                    android:layout_marginEnd="@dimen/keyline_2"
                    android:background="?attr/daxColorLines" />

                <com.duckduckgo.common.ui.view.text.DaxTextView
                    android:id="@+id/tierName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:textType="primary"
                    app:typography="body2"
                    tools:text="PRO"
                    tools:visibility="visible" />

            </LinearLayout>

            <com.duckduckgo.common.ui.view.InfoPanel
                android:id="@+id/pendingDowngradeInfoPanel"
                style="@style/Widget.DuckDuckGo.InfoPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/keyline_5"
                android:layout_marginTop="@dimen/keyline_4"
                android:visibility="gone"
                app:panelBackground="@drawable/info_panel_tooltip_background" />

            <LinearLayout
                android:id="@+id/onboardingProgressCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/keyline_5"
                android:layout_marginTop="@dimen/keyline_6"
                android:background="@drawable/background_grey_rounded_corners"
                android:orientation="vertical"
                android:padding="@dimen/keyline_4"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/onboardingProgressHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/onboardingProgressIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="@dimen/keyline_2"
                        android:importantForAccessibility="no"
                        android:src="@drawable/subscription_56" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.duckduckgo.common.ui.view.text.DaxTextView
                            android:id="@+id/onboardingProgressTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:textType="primary"
                            app:typography="h2"
                            tools:text="Setup 75% complete" />

                        <com.duckduckgo.common.ui.view.text.DaxTextView
                            android:id="@+id/onboardingProgressDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/keyline_1"
                            android:text="@string/subscriptionOnboardingSettingsCardDescription"
                            app:textType="secondary"
                            app:typography="body1" />

                    </LinearLayout>

                </LinearLayout>

                <com.duckduckgo.common.ui.view.button.DaxButtonPrimary
                    android:id="@+id/onboardingProgressButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/keyline_4"
                    android:text="@string/subscriptionOnboardingSettingsCardButton"
                    app:daxButtonSize="small" />

            </LinearLayout>

            <com.duckduckgo.common.ui.view.divider.HorizontalDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/keyline_4" />

            <LinearLayout
                android:id="@+id/upgradeToProContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.duckduckgo.common.ui.view.listitem.TwoLineListItem
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:leadingIcon="@drawable/ai_chat_advanced_color_24"
                    app:primaryText="@string/subscriptionsProUpgradeTitle"
                    app:primaryTextColorOverlay="?attr/daxColorAccentBlue"
                    app:secondaryText="@string/subscriptionsProUpgradeMessage"
                    app:secondaryTextColorOverlay="?attr/daxColorPrimaryText" />

                <com.duckduckgo.common.ui.view.divider.HorizontalDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <com.duckduckgo.common.ui.view.listitem.SectionHeaderListItem
                android:id="@+id/activateOnOtherDevices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:primaryText="@string/activateOnOtherDevices" />

            <com.duckduckgo.common.ui.view.listitem.TwoLineListItem
                android:id="@+id/manageEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/editEmailPrimaryText" />

            <com.duckduckgo.common.ui.view.listitem.TwoLineListItem
                android:id="@+id/addToDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/addToDevicePrimaryText"
                tools:secondaryText="@string/addToDeviceSecondaryText" />

            <com.duckduckgo.common.ui.view.listitem.OneLineListItem
                android:id="@+id/learnMore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/learnMore" />

            <com.duckduckgo.common.ui.view.divider.HorizontalDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.duckduckgo.common.ui.view.listitem.SectionHeaderListItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/subscriptionSettingSectionManageSubscription" />

            <com.duckduckgo.common.ui.view.listitem.OneLineListItem
                android:id="@+id/viewAllPlansTop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:primaryText="@string/subscriptionSettingViewAllPlans"
                tools:visibility="visible" />

            <com.duckduckgo.common.ui.view.listitem.TwoLineListItem
                android:id="@+id/changePlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:primaryText="@string/subscriptionSettingManagePaymentOrCancel"
                tools:secondaryText="Your monthly subscription renews on April 20, 2027."
                tools:visibility="visible" />

            <com.duckduckgo.common.ui.view.listitem.OneLineListItem
                android:id="@+id/viewPlans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:primaryText="@string/subscriptionSettingExpiredViewPlans" />

            <com.duckduckgo.common.ui.view.listitem.OneLineListItem
                android:id="@+id/removeDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/subscriptionSettingRemoveFromDevice" />

            <com.duckduckgo.common.ui.view.divider.HorizontalDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.duckduckgo.common.ui.view.listitem.SectionHeaderListItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/subscriptionSettingSectionHelpAndSupport" />

            <com.duckduckgo.common.ui.view.listitem.TwoLineListItem
                android:id="@+id/faq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:primaryText="@string/privacyProFaq"
                tools:secondaryText="@string/privacyProFaqSecondary" />

            <com.duckduckgo.common.ui.view.listitem.OneLineListItem
                android:id="@+id/privacyPolicy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/privacyPolicyAndTermsOfService" />

            <com.duckduckgo.common.ui.view.listitem.OneLineListItem
                android:id="@+id/sendFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:primaryText="@string/subscriptionSettingSendFeedback" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
