<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/keyline_5"
    android:gravity="center"
    android:orientation="vertical"
    tools:showIn="@layout/fragment_read_sync_code_camera">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_no_camera_hardware_128" />

    <com.duckduckgo.common.ui.view.text.DaxTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/keyline_4"
        android:gravity="center_horizontal"
        android:text="@string/sync_simplified_scanner_no_permission_headline_v2"
        app:typography="h2" />

    <com.duckduckgo.common.ui.view.text.DaxTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/keyline_4"
        android:gravity="center_horizontal"
        android:text="@string/sync_simplified_scanner_no_permission_body_v2"
        app:textType="secondary"
        app:typography="body2" />

    <com.duckduckgo.common.ui.view.button.DaxButtonPrimary
        android:id="@+id/changePermissionsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/keyline_5"
        android:text="@string/sync_simplified_scanner_no_permission_primary_button_v2"
        app:daxButtonSize="small" />

</LinearLayout>