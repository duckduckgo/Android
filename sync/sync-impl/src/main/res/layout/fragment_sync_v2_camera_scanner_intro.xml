<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:showIn="@layout/fragment_sync_v2_camera_scanner">

    <com.duckduckgo.sync.impl.ui.v2.CodeExchangeHeaderView
        android:id="@+id/codeExchangeHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/keyline_4"
        android:layout_marginTop="@dimen/keyline_5"
        app:bodyText="@string/sync_scanner_v2_scan_qr_code_body"
        app:headlineText="@string/sync_scanner_v2_scan_qr_code_headline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/introAnimation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:saveEnabled="false"
        app:layout_constraintBottom_toTopOf="@+id/buttonsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/codeExchangeHeader"
        app:lottie_loop="false"
        app:lottie_rawRes="@raw/sync_camera_intro_animation" />

    <FrameLayout
        android:id="@+id/buttonsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/keyline_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.duckduckgo.common.ui.view.button.DaxButtonSecondary
            android:id="@+id/readyToScanSecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sync_scanner_v2_scan_button_cta"
            app:daxButtonSize="small" />

        <com.duckduckgo.common.ui.view.button.DaxButtonPrimary
            android:id="@+id/readyToScanPrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sync_scanner_v2_scan_button_cta"
            android:visibility="gone"
            app:daxButtonSize="small" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

