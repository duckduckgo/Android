<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/daxColorSurface">

    <ScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.duckduckgo.sync.impl.ui.v2.SyncPairingHeaderView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/keyline_4"
                android:layout_marginTop="@dimen/keyline_5"
                app:bodyText="@string/sync_scanner_v2_manual_entry_screen_body"
                app:headlineText="@string/sync_scanner_v2_manual_entry_screen_headline" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/entryContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="@dimen/keyline_4"
                android:layout_marginVertical="@dimen/keyline_5"
                android:layout_weight="1"
                android:background="@drawable/background_read_sync_code_panel"
                android:padding="20dp">

                <com.duckduckgo.common.ui.view.text.DaxTextView
                    android:id="@+id/exampleCodeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sync_scanner_v2_manual_entry_example_code_label"
                    app:layout_constraintBottom_toTopOf="@id/exampleCode"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:textType="primary"
                    app:typography="body1_mono" />

                <com.duckduckgo.common.ui.view.text.DaxTextView
                    android:id="@+id/exampleCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/keyline_2"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:maxLines="2"
                    android:text="@string/sync_scanner_v2_manual_entry_example_code"
                    app:layout_constraintBottom_toTopOf="@id/pasteCodeButton"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/exampleCodeLabel"
                    app:textType="secondary"
                    app:typography="body1_mono" />

                <com.duckduckgo.common.ui.view.button.DaxButtonPrimary
                    android:id="@+id/pasteCodeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/keyline_5"
                    android:text="@string/sync_scanner_v2_manual_entry_paste_button"
                    app:daxButtonSize="large"
                    app:icon="@drawable/ic_copy_24"
                    app:iconGravity="textStart"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/exampleCode" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
