<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/turnOffSyncSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/turnOffSyncContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.duckduckgo.common.ui.view.text.DaxTextView
            android:id="@+id/removeDeviceTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/keyline_5"
            android:layout_marginTop="@dimen/keyline_5"
            android:layout_marginEnd="@dimen/keyline_3"
            app:layout_constraintEnd_toStartOf="@id/closeButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:typography="h2"
            tools:text="Remove Pixel 9 from Sync &amp; Backup?" />

        <com.duckduckgo.common.ui.view.text.DaxTextView
            android:id="@+id/removeDeviceBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/keyline_1"
            app:layout_constraintEnd_toEndOf="@id/removeDeviceTitle"
            app:layout_constraintStart_toStartOf="@id/removeDeviceTitle"
            app:layout_constraintTop_toBottomOf="@id/removeDeviceTitle"
            app:textType="secondary"
            app:typography="body2"
            tools:text="“Pixel 9” will no longer be able to access your synced data on other devices." />

        <com.duckduckgo.common.ui.view.text.DaxTextView
            android:id="@+id/turnOffTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/keyline_5"
            android:layout_marginTop="@dimen/keyline_5"
            android:layout_marginEnd="@dimen/keyline_3"
            android:text="@string/sync_simplified_settings_turn_off_sheet_title"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/closeButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:typography="h2" />

        <com.duckduckgo.common.ui.view.text.DaxTextView
            android:id="@+id/turnOffBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/keyline_1"
            android:text="@string/sync_simplified_settings_turn_off_sheet_body"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/turnOffTitle"
            app:layout_constraintStart_toStartOf="@id/turnOffTitle"
            app:layout_constraintTop_toBottomOf="@id/turnOffTitle"
            app:textType="secondary"
            app:typography="body2" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/headerBottomBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierAllowsGoneWidgets="false"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="removeDeviceBody,turnOffBody" />

        <com.duckduckgo.common.ui.view.button.IconButton
            android:id="@+id/closeButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="@dimen/keyline_4"
            android:layout_marginEnd="@dimen/keyline_4"
            android:background="@drawable/background_turn_off_sync_sheet_close_button"
            android:contentDescription="@string/closeButtonContentDescription"
            android:padding="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_close_24_small" />

        <com.duckduckgo.common.ui.view.divider.HorizontalDivider
            android:id="@+id/headerDivider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/keyline_5"
            app:defaultPadding="false"
            app:fullWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerBottomBarrier" />

        <View
            android:id="@+id/deleteServerDataIconBackground"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/keyline_5"
            android:background="@drawable/list_item_image_circular_background"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@id/deleteServerDataHint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/deleteServerDataTitle" />

        <ImageView
            android:id="@+id/deleteServerDataIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_trash_24"
            app:layout_constraintBottom_toBottomOf="@id/deleteServerDataIconBackground"
            app:layout_constraintEnd_toEndOf="@id/deleteServerDataIconBackground"
            app:layout_constraintStart_toStartOf="@id/deleteServerDataIconBackground"
            app:layout_constraintTop_toTopOf="@id/deleteServerDataIconBackground" />

        <com.duckduckgo.common.ui.view.text.DaxTextView
            android:id="@+id/deleteServerDataTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/keyline_4"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="@dimen/keyline_4"
            android:text="@string/sync_simplified_settings_turn_off_sheet_remove_item"
            app:layout_constraintEnd_toStartOf="@id/deleteServerDataSwitch"
            app:layout_constraintStart_toEndOf="@id/deleteServerDataIconBackground"
            app:layout_constraintTop_toBottomOf="@id/headerDivider"
            app:typography="body1" />

        <com.duckduckgo.common.ui.view.text.DaxTextView
            android:id="@+id/deleteServerDataHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/keyline_0"
            android:layout_marginBottom="22dp"
            android:text="@string/sync_simplified_settings_turn_off_sheet_remove_item_hint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/deleteServerDataTitle"
            app:layout_constraintStart_toStartOf="@id/deleteServerDataTitle"
            app:layout_constraintTop_toBottomOf="@id/deleteServerDataTitle"
            app:textType="secondary"
            app:typography="body2" />

        <com.duckduckgo.common.ui.view.DaxSwitch
            android:id="@+id/deleteServerDataSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/keyline_5"
            android:contentDescription="@string/sync_simplified_settings_turn_off_sheet_remove_item"
            app:layout_constraintBottom_toBottomOf="@id/deleteServerDataHint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/deleteServerDataTitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/devicesSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="@dimen/keyline_4"
        android:visibility="gone">

        <com.duckduckgo.common.ui.view.divider.HorizontalDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:fullWidth="true" />

        <com.duckduckgo.common.ui.view.listitem.SectionHeaderListItem
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:primaryText="@string/sync_simplified_settings_devices_section_header" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/devicesRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/turnOffButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/keyline_5"
        android:paddingBottom="@dimen/keyline_4">

        <com.duckduckgo.common.ui.view.button.DaxButtonDestructiveSecondary
            android:id="@+id/turnOffButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:text="@string/sync_simplified_settings_turn_off_sheet_remove_primary_button"
            app:daxButtonSize="small" />

        <com.duckduckgo.common.ui.view.button.DaxButtonDestructive
            android:id="@+id/turnOffAndDeleteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:alpha="0"
            android:visibility="invisible"
            android:text="@string/sync_simplified_settings_turn_off_sheet_primary_button_delete"
            app:daxButtonSize="small" />

    </FrameLayout>

</LinearLayout>
