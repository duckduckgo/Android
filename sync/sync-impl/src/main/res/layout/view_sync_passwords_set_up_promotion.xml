<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:paddingHorizontal="@dimen/keyline_4"
    android:paddingTop="@dimen/keyline_4"
    android:paddingBottom="@dimen/keyline_2">

    <com.duckduckgo.sync.impl.promotion.widget.PromoMessageView
        android:id="@+id/promoMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:promoHeaderImage="@drawable/sync_pending_96"
        app:promoMessageText="@string/syncPromoSubtitlePasswords"
        app:promoPrimaryButtonText="@string/sync_passwords_promo_primary_button"
        app:promoShowCloseButton="true"
        app:promoShowElevation="true"
        app:promoTitleText="@string/syncPromoTitlePasswords" />

</FrameLayout>
