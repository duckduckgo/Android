<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/keyline_4"
        android:background="@drawable/background_large_rounded_surface"
        android:paddingVertical="@dimen/keyline_2">

        <com.duckduckgo.common.ui.view.listitem.OneLineListItem
            android:id="@+id/syncThisDeviceToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:primaryText="@string/sync_simplified_settings_sync_this_device_item"
            app:showSwitch="true" />
    </FrameLayout>

    <com.duckduckgo.common.ui.view.button.DaxButtonSecondary
        android:id="@+id/syncWithAnotherDeviceButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginHorizontal="@dimen/keyline_4"
        android:layout_marginVertical="@dimen/keyline_5"
        android:text="@string/sync_simplified_settings_sync_with_another_device_button"
        app:daxButtonSize="large"
        app:icon="@drawable/ic_qr2_24"
        app:iconGravity="textStart" />

    <com.duckduckgo.common.ui.view.divider.HorizontalDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/keyline_4" />

    <com.duckduckgo.common.ui.view.listitem.SectionHeaderListItem
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:primaryText="@string/sync_simplified_settings_recover_section_header" />

    <com.duckduckgo.common.ui.view.listitem.OneLineListItem
        android:id="@+id/recoverDataItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:primaryText="@string/sync_simplified_settings_recover_data_item" />

    <com.duckduckgo.common.ui.view.divider.HorizontalDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/keyline_4" />

    <com.duckduckgo.common.ui.view.listitem.SectionHeaderListItem
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:primaryText="@string/sync_simplified_settings_download_section_header" />

    <com.duckduckgo.sync.impl.ui.v2.GetOnOtherPlatformsListItem
        android:id="@+id/get_on_other_platforms_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
