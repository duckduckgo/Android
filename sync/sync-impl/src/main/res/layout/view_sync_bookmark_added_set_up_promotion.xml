<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/promoCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/keyline_2"
    android:layout_marginVertical="@dimen/keyline_3"
    android:background="@drawable/sync_bookmark_added_set_up_promotion_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    tools:ignore="Overdraw">

    <com.duckduckgo.common.ui.view.listitem.OneLineListItem
        android:id="@+id/promoItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:leadingIcon="@drawable/ic_sync_24"
        app:primaryText="@string/sync_bookmark_added_set_up_promo_title"
        app:showSwitch="true" />

    <ImageView
        android:id="@+id/overflowIcon"
        android:layout_width="@dimen/listItemImageContainerSize"
        android:layout_height="@dimen/listItemImageContainerSize"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/keyline_2"
        android:contentDescription="@string/sync_bookmark_added_set_up_promo_more_options"
        app:srcCompat="@drawable/ic_menu_vertical_24" />

</LinearLayout>
