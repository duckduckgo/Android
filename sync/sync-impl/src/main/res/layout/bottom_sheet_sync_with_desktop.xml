<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/syncWithDesktopSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/keyline_4">

    <com.duckduckgo.common.ui.view.button.IconButton
        android:id="@+id/closeButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="@dimen/keyline_4"
        android:layout_marginEnd="@dimen/keyline_4"
        android:background="@drawable/background_turn_off_sync_sheet_close_button"
        android:contentDescription="@string/closeButtonContentDescription"
        android:padding="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_close_24_small" />

    <ImageView
        android:id="@+id/illustration"
        android:layout_width="128dp"
        android:layout_height="96dp"
        android:layout_marginTop="40dp"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/laptop_ddginstall_128" />

    <com.duckduckgo.common.ui.view.text.DaxTextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="@dimen/keyline_5"
        android:gravity="center"
        android:text="@string/sync_bookmark_added_multi_device_sheet_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/illustration"
        app:typography="h1" />

    <com.duckduckgo.common.ui.view.button.DaxButtonPrimary
        android:id="@+id/syncWithDesktopButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/keyline_5"
        android:text="@string/sync_bookmark_added_multi_device_sheet_primary_button"
        app:daxButtonSize="large"
        app:layout_constraintEnd_toEndOf="@id/title"
        app:layout_constraintStart_toStartOf="@id/title"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <com.duckduckgo.common.ui.view.button.DaxButtonSecondary
        android:id="@+id/noDesktopAppButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/sync_bookmark_added_multi_device_sheet_secondary_button"
        app:daxButtonSize="large"
        app:layout_constraintEnd_toEndOf="@id/title"
        app:layout_constraintStart_toStartOf="@id/title"
        app:layout_constraintTop_toBottomOf="@id/syncWithDesktopButton" />

</androidx.constraintlayout.widget.ConstraintLayout>
