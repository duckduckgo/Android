<resources>
    <!-- Our app theme sets colorPrimary to the background color, which Material pickers use for the header,
         the selection and the buttons. We remap the Material color roles to design system colors. -->
    <style name="ThemeOverlay.SyncInternal.MaterialCalendar" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">?attr/daxColorAccentBlue</item>
        <item name="colorOnPrimary">?attr/daxColorWhite</item>
        <item name="colorSurface">?attr/daxColorSurface</item>
        <item name="colorOnSurface">?attr/daxColorPrimaryText</item>
        <item name="colorOnSurfaceVariant">?attr/daxColorSecondaryText</item>
    </style>

    <style name="ThemeOverlay.SyncInternal.MaterialTimePicker" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="colorPrimary">?attr/daxColorAccentBlue</item>
        <item name="colorOnPrimary">?attr/daxColorWhite</item>
        <item name="colorSurface">?attr/daxColorSurface</item>
        <item name="colorOnSurface">?attr/daxColorPrimaryText</item>
        <item name="colorOnSurfaceVariant">?attr/daxColorSecondaryText</item>
    </style>
</resources>
