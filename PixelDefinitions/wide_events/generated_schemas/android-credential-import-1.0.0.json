{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "User taps import (or a direct import starts) in the Import Passwords dialog. One event per attempt, covering the Android credential exchange, the Google web flow, and a credential exchange failure that falls back to the web flow.",
    "$comment": "{\"owners\":[\"CDRussell\"]}",
    "type": "object",
    "required": ["meta", "global", "feature", "app", "context"],
    "additionalProperties": false,
    "properties": {
        "meta": {
            "type": "object",
            "required": ["type", "version"],
            "additionalProperties": false,
            "properties": { "type": { "const": "android-credential-import" }, "version": { "const": "1.0.0" } }
        },
        "app": {
            "type": "object",
            "required": ["name", "version"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "description": "The name of the application sending the event",
                    "enum": ["DuckDuckGo Android"]
                },
                "version": {
                    "type": "string",
                    "description": "The version of the app sending the event. Release builds are X.Y.Z; internal and nightly builds append the build number and channel suffix.",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+(-[a-z]+)?)?$"
                },
                "form_factor": { "type": "string", "description": "The form factor of the current device", "enum": ["phone", "tablet"] },
                "dev_mode": { "type": "boolean", "description": "Whether the app is a debug build" }
            }
        },
        "global": {
            "type": "object",
            "required": ["platform", "type", "sample_rate"],
            "additionalProperties": false,
            "properties": {
                "platform": { "type": "string", "description": "The platform the app is running on", "enum": ["Android"] },
                "type": { "type": "string", "description": "The type of software sending the event", "enum": ["app"] },
                "sample_rate": {
                    "type": "number",
                    "description": "Sample rate for this event, between 0 and 1",
                    "minimum": 0,
                    "maximum": 1
                },
                "is_first_daily_occurrence": {
                    "type": "boolean",
                    "description": "Whether this is the first event completed with this feature name and status in the current UTC calendar day"
                }
            }
        },
        "feature": {
            "type": "object",
            "required": ["name", "status", "data"],
            "additionalProperties": false,
            "properties": {
                "name": { "type": "string", "description": "The feature name for this event", "enum": ["credential-import"] },
                "status": {
                    "type": "string",
                    "description": "The terminal status of the flow",
                    "enum": ["SUCCESS", "FAILURE", "CANCELLED", "UNKNOWN"]
                },
                "data": {
                    "type": "object",
                    "required": ["ext"],
                    "additionalProperties": false,
                    "properties": {
                        "ext": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "initial_flow": {
                                    "type": "string",
                                    "description": "Import flow the attempt started with",
                                    "enum": ["credential_exchange", "webflow"]
                                },
                                "fallback": {
                                    "type": "string",
                                    "description": "Whether a credential exchange failure made the attempt fall back to the web flow",
                                    "enum": ["true", "false"]
                                },
                                "cxf_failure_reason": {
                                    "type": "string",
                                    "description": "Why the credential exchange failed. Only present when it failed.",
                                    "enum": ["not_supported", "no_exporter_available", "malformed_payload", "unknown"]
                                },
                                "exporter": {
                                    "type": "string",
                                    "description": "Password manager that responded to the credential exchange, from a fixed list. Present when it sent credentials, or sent data that could not be read (malformed_payload).",
                                    "enum": ["google", "1password", "bitwarden", "dashlane", "other"]
                                },
                                "saved_credentials": {
                                    "type": "string",
                                    "description": "Number of credentials imported, bucketed. Only present on SUCCESS events.",
                                    "enum": ["none", "few", "some", "many", "lots"]
                                },
                                "skipped_credentials": {
                                    "type": "string",
                                    "description": "Number of credentials skipped because they were already saved or repeated, bucketed. Only present on SUCCESS events.",
                                    "enum": ["none", "few", "some", "many", "lots"]
                                },
                                "total_duration_ms_bucketed": {
                                    "type": "string",
                                    "description": "Time from the import tap to the end of the attempt in milliseconds, bucketed",
                                    "enum": ["-1", "0", "1000", "5000", "10000", "30000", "60000", "300000", "600000"]
                                },
                                "last_step": {
                                    "type": "string",
                                    "description": "Where the attempt was when it ended: credential_exchange (picker open), webflow (web flow open), importing (saving passwords)",
                                    "enum": ["credential_exchange", "webflow", "importing"]
                                },
                                "failure_reason": {
                                    "type": "string",
                                    "description": "Reason for failure. Only present on FAILURE events.",
                                    "enum": ["error_parsing", "webview_crash", "credential_exchange_failed"]
                                },
                                "step.credential_exchange": {
                                    "type": "string",
                                    "description": "Present if the credential exchange ended with a result: true when it returned credentials, false when it failed",
                                    "enum": ["true", "false"]
                                },
                                "step.webflow": {
                                    "type": "string",
                                    "description": "Present if the web flow ended with a result: true when it returned credentials, false when it failed",
                                    "enum": ["true", "false"]
                                }
                            }
                        }
                    }
                }
            }
        },
        "context": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Entry point the flow was started from",
                    "enum": [
                        "password_management_promo",
                        "password_management_empty_state",
                        "password_management_overflow",
                        "autofill_settings_button",
                        "in_browser_promo",
                        "settings",
                        "onboarding",
                        "unknown"
                    ]
                }
            }
        }
    }
}
