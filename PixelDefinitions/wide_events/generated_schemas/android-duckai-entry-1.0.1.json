{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Captures each Duck.ai entry through exit, app background, or termination, including prompt conversion and bucketed latency. Sample rate is 1.0.",
    "$comment": "{\"owners\":[\"malmstein\"]}",
    "type": "object",
    "required": ["meta", "global", "feature", "app"],
    "additionalProperties": false,
    "properties": {
        "meta": {
            "type": "object",
            "required": ["type", "version"],
            "additionalProperties": false,
            "properties": { "type": { "const": "android-duckai-entry" }, "version": { "const": "1.0.1" } }
        },
        "app": {
            "type": "object",
            "required": ["name", "version"],
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "description": "The name of the application sending the event",
                    "enum": ["DuckDuckGo Android"]
                },
                "version": {
                    "type": "string",
                    "description": "The version of the app when the event's flow started. Release builds are X.Y.Z; internal and nightly builds append the build number and channel suffix.",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+(-[a-z]+)?)?$"
                },
                "form_factor": { "type": "string", "description": "The form factor of the current device", "enum": ["phone", "tablet"] },
                "dev_mode": { "type": "boolean", "description": "Whether the app is a debug build" }
            }
        },
        "global": {
            "type": "object",
            "required": ["platform", "type", "sample_rate"],
            "additionalProperties": false,
            "properties": {
                "platform": { "type": "string", "description": "The platform the app is running on", "enum": ["Android"] },
                "type": { "type": "string", "description": "The type of software sending the event", "enum": ["app"] },
                "sample_rate": {
                    "type": "number",
                    "description": "Sample rate for this event, between 0 and 1",
                    "minimum": 0,
                    "maximum": 1
                },
                "is_first_daily_occurrence": {
                    "type": "boolean",
                    "description": "Whether this is the first event completed with this feature name and status in the current UTC calendar day"
                }
            }
        },
        "feature": {
            "type": "object",
            "required": ["name", "status", "data"],
            "additionalProperties": false,
            "properties": {
                "name": { "type": "string", "description": "The feature name for this event", "enum": ["duckai_entry"] },
                "status": {
                    "type": "string",
                    "description": "The terminal status of the flow",
                    "enum": ["SUCCESS", "CANCELLED", "UNKNOWN"]
                },
                "data": {
                    "type": "object",
                    "required": ["ext"],
                    "additionalProperties": false,
                    "properties": {
                        "ext": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "source": {
                                    "type": "string",
                                    "description": "Entry point that opened Duck.ai",
                                    "enum": [
                                        "address_bar_prompt",
                                        "address_bar_icon",
                                        "address_bar_shortcut_chip",
                                        "address_bar_editing_state",
                                        "suggestion_ask_ai",
                                        "browsing_menu_ntp",
                                        "browsing_menu_webpage",
                                        "browsing_menu_duckai",
                                        "tab_switcher",
                                        "tab_switcher_existing_chat",
                                        "chat_history_new_chat",
                                        "chat_history_open_chat",
                                        "voice",
                                        "onboarding",
                                        "subscription_onboarding",
                                        "direct_url",
                                        "serp",
                                        "ddg_homepage",
                                        "icon_shortcut",
                                        "contextual_chat",
                                        "widget_quick_actions",
                                        "widget_favorite",
                                        "system_search",
                                        "digital_assistant",
                                        "deep_link_other",
                                        "paid_settings",
                                        "return_to_chat_card",
                                        "duck_ai_new_chat",
                                        "recent_chat_tab_switcher",
                                        "recent_chat_contextual",
                                        "chat_suggestion_input",
                                        "tab_swiped",
                                        "app_open"
                                    ]
                                },
                                "voice_chat": {
                                    "type": "string",
                                    "description": "Whether this entry starts a voice chat. Dictated text prompts are false.",
                                    "enum": ["true", "false"]
                                },
                                "has_prompt": {
                                    "type": "string",
                                    "description": "Whether the entry carried a prompt",
                                    "enum": ["true", "false"]
                                },
                                "chat_state": {
                                    "type": "string",
                                    "description": "Whether the entry URL carries a chat identifier. The identifier itself is never sent",
                                    "enum": ["new", "existing"]
                                },
                                "surface": {
                                    "type": "string",
                                    "description": "Duck.ai surface opened for the entry",
                                    "enum": ["duck_ai_tab", "contextual_sheet"]
                                },
                                "prompt_submitted": {
                                    "type": "string",
                                    "description": "Whether a prompt was submitted during this entry",
                                    "enum": ["true", "false"]
                                },
                                "time_to_first_prompt_ms_bucketed": {
                                    "type": "string",
                                    "description": "Time from entry to first submitted prompt, rounded down to a bucket boundary in milliseconds",
                                    "enum": ["0", "1000", "5000", "10000", "30000", "60000", "300000", "600000"]
                                },
                                "time_in_duckai_ms_bucketed": {
                                    "type": "string",
                                    "description": "Time from entry to exit, rounded down to a bucket boundary in milliseconds",
                                    "enum": ["0", "1000", "5000", "10000", "30000", "60000", "300000", "600000"]
                                },
                                "exit_trigger": {
                                    "type": "string",
                                    "description": "Action that left Duck.ai. search_started is a submitted web search from the Duck.ai tab; chat_deleted is deletion of the active chat from native history. Present only when status_reason is left_duckai",
                                    "enum": [
                                        "back_or_close",
                                        "tab_switched",
                                        "new_tab_opened",
                                        "fire_tab_opened",
                                        "search_started",
                                        "other_navigation",
                                        "chat_deleted"
                                    ]
                                },
                                "status_reason": {
                                    "type": "string",
                                    "description": "Reason the entry ended: left_duckai and new_entry are SUCCESS regardless of prompt submission; app_backgrounded is CANCELLED; app_terminated is UNKNOWN after process-kill cleanup",
                                    "enum": ["left_duckai", "new_entry", "app_backgrounded", "app_terminated"]
                                },
                                "step.entry_resolved": {
                                    "type": "string",
                                    "description": "Present when the destination tab URL resolved the entry chat state",
                                    "enum": ["true"]
                                },
                                "step.prompt_submitted": {
                                    "type": "string",
                                    "description": "Present when the first submitted prompt was recorded",
                                    "enum": ["true"]
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
