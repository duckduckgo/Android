{
    "android-duckai-response-wait": {
        "description": "Captures how long a user waits on a Duck.ai response in the full Duck.ai tab, whether they leave while it is pending, and whether they come back to it.",
        "owners": ["LukasPaczos"],
        "meta": {
            "type": "android-duckai-response-wait",
            "version": "0.0"
        },
        "feature": {
            "name": "duckai-response-wait",
            "status": ["SUCCESS", "FAILURE"],
            "data": {
                "ext": {
                    "reasoning_effort": {
                        "type": "string",
                        "description": "Reasoning effort selected for the prompt. Present only when an effort was selected",
                        "enum": ["none", "minimal", "low", "medium", "high"]
                    },
                    "used_reasoning": {
                        "type": "string",
                        "description": "Whether the prompt used reasoning (low, medium or high effort). Present from the start of the flow",
                        "enum": ["true", "false"]
                    },
                    "used_extended_reasoning": {
                        "type": "string",
                        "description": "Whether the prompt used extended reasoning (medium or high effort). Present from the start of the flow",
                        "enum": ["true", "false"]
                    },
                    "user_requested_image_generation": {
                        "type": "string",
                        "description": "Whether the user selected the image generation tool for the prompt. Present from the start of the flow",
                        "enum": ["true", "false"]
                    },
                    "user_requested_web_search": {
                        "type": "string",
                        "description": "Whether the user selected the web search tool for the prompt. Present from the start of the flow",
                        "enum": ["true", "false"]
                    },
                    "status_reason": {
                        "type": "string",
                        "description": "Reason the flow ended: watched when the user stayed on the tab until the response finished, returned when the user came back to the tab after leaving, not_returned when the user never came back before the flow expired",
                        "enum": ["watched", "returned", "not_returned"]
                    },
                    "response_result": {
                        "type": "string",
                        "description": "Outcome of the response as last observed. unknown until the page reports a terminal state. Present on every event",
                        "enum": ["ready", "error", "stopped", "unknown"]
                    },
                    "step.left": {
                        "type": "string",
                        "description": "Parameter present when the user left the Duck.ai tab while the response was still pending or ready",
                        "enum": ["true"]
                    },
                    "left_via": {
                        "type": "string",
                        "description": "How the user left the Duck.ai tab. Present only when step.left is present",
                        "enum": [
                            "app_backgrounded",
                            "chat_switched",
                            "tab_switched",
                            "new_tab_opened",
                            "back_or_close",
                            "fire_tab_opened",
                            "other_navigation"
                        ]
                    },
                    "step.response_ready_while_away": {
                        "type": "string",
                        "description": "Parameter present when the response finished while the user was away from the tab",
                        "enum": ["true"]
                    },
                    "step.returned": {
                        "type": "string",
                        "description": "Parameter present when the user came back to the Duck.ai tab after leaving",
                        "enum": ["true"]
                    },
                    "response_state_on_return": {
                        "type": "string",
                        "description": "State of the response at the moment the user came back. page_reloaded when the page was reloaded after the app process was killed, so the reported state is not trusted. Present only when step.returned is present",
                        "enum": ["loading", "ready", "error", "page_reloaded"]
                    },
                    "step.prompt_after_return": {
                        "type": "string",
                        "description": "Parameter present when the user submitted another prompt in the same tab after returning",
                        "enum": ["true"]
                    },
                    "prompt_to_leave_ms_bucketed": {
                        "type": "string",
                        "description": "Time from prompt submission to the user leaving the tab, bucketed (lower end of bucket, in ms). -1 when the measured duration was negative. Present only when step.left is present",
                        "enum": ["-1", "0", "2000", "5000", "10000", "20000", "30000"]
                    },
                    "leave_to_return_ms_bucketed": {
                        "type": "string",
                        "description": "Time from the user leaving the tab to coming back, bucketed (lower end of bucket, in ms). -1 when the measured duration was negative. Present only when step.returned is present",
                        "enum": ["-1", "0", "5000", "10000", "30000", "60000", "300000", "900000", "3600000"]
                    },
                    "ready_to_return_ms_bucketed": {
                        "type": "string",
                        "description": "Time from the response finishing while the user was away to the user coming back, bucketed (lower end of bucket, in ms). -1 when the measured duration was negative. Present only when the response finished while away and the user returned",
                        "enum": ["-1", "0", "5000", "10000", "30000", "60000", "300000", "900000", "3600000"]
                    }
                }
            }
        }
    }
}
