{
    "android-subscription-undo-cancellation": {
        "description": "User taps Keep Subscription to undo a cancelled Google Play subscription before it expires.",
        "owners": ["nalcalag"],
        "meta": {
            "type": "android-subscription-undo-cancellation",
            "version": "0.0"
        },
        "feature": {
            "name": "subscription-undo-cancellation",
            "status": ["SUCCESS", "FAILURE", "CANCELLED", "UNKNOWN"],
            "data": {
                "ext": {
                    "plan": {
                        "type": "string",
                        "description": "Plan ID of the cancelled subscription",
                        "enum": [
                            "ddg-privacy-pro-monthly-renews-us",
                            "ddg-privacy-pro-monthly-renews-row",
                            "ddg-privacy-pro-yearly-renews-us",
                            "ddg-privacy-pro-yearly-renews-row",
                            "ddg-subscription-pro-yearly-renews-us",
                            "ddg-subscription-pro-monthly-renews-us",
                            "ddg-subscription-pro-yearly-renews-row",
                            "ddg-subscription-pro-monthly-renews-row"
                        ]
                    },
                    "free_trial": {
                        "type": "string",
                        "description": "Whether the subscription is in a free trial",
                        "enum": ["true", "false"]
                    },
                    "days_to_expiry": {
                        "type": "string",
                        "description": "Days left until the subscription expires, bucketed",
                        "enum": ["d0", "d1_to_d3", "d4_to_d7", "d8_plus"]
                    },
                    "method": {
                        "type": "string",
                        "description": "How the undo is done: in the app, or in the Play Store when the Play account on the device doesn't own the subscription",
                        "enum": ["in_app", "store"]
                    },
                    "activation_latency_ms_bucketed": {
                        "type": "string",
                        "description": "Duration from the Play purchase (or the Play Store fallback) to renewal being back on, in milliseconds, bucketed using the lower bucket boundary",
                        "enum": ["-1", "0", "1000", "5000", "10000", "30000", "60000", "300000", "600000"]
                    },
                    "confirm_failure_reason": {
                        "type": "string",
                        "description": "Why the backend confirm failed. Only present when step.confirm_purchase is false",
                        "enum": ["confirm_request_failed", "confirm_not_active"]
                    },
                    "failure_reason": {
                        "type": "string",
                        "description": "Play billing error. Only present on FAILURE events.",
                        "enum": [
                            "SERVICE_TIMEOUT",
                            "FEATURE_NOT_SUPPORTED",
                            "SERVICE_DISCONNECTED",
                            "USER_CANCELED",
                            "SERVICE_UNAVAILABLE",
                            "BILLING_UNAVAILABLE",
                            "ITEM_UNAVAILABLE",
                            "DEVELOPER_ERROR",
                            "ERROR",
                            "ITEM_ALREADY_OWNED",
                            "ITEM_NOT_OWNED",
                            "NETWORK_ERROR",
                            "UNKNOWN_ERROR",
                            "BILLING_CRASH_ERROR",
                            "UNKNOWN",
                            "empty old purchase token",
                            "Missing product details"
                        ]
                    },
                    "step.check_eligibility": {
                        "type": "string",
                        "description": "True if the undo can be done in the app, false if the user is sent to the Play Store",
                        "enum": ["true", "false"]
                    },
                    "step.billing_flow_init": {
                        "type": "string",
                        "description": "Whether the Play billing sheet opened",
                        "enum": ["true", "false"]
                    },
                    "step.billing_flow_purchase": {
                        "type": "string",
                        "description": "Whether the user confirmed in the Play billing sheet",
                        "enum": ["true", "false"]
                    },
                    "step.confirm_purchase": {
                        "type": "string",
                        "description": "Whether the backend confirmed the renewal is back on",
                        "enum": ["true", "false"]
                    }
                }
            }
        }
    }
}
