{
    "android-duckai-selection-journey": {
        "description": "Captures a set of text selections from the moment the first is attached to Duck.ai until the user submits them or abandons them, so drop-off between attaching text and asking about it can be measured.",
        "owners": ["joshliebe"],
        "meta": {
            "type": "android-duckai-selection-journey",
            "version": "0.0"
        },
        "feature": {
            "name": "duckai-selection-journey",
            "status": ["SUCCESS", "CANCELLED", "UNKNOWN"],
            "data": {
                "ext": {
                    "outcome.terminal_reason": {
                        "type": "string",
                        "description": "Why the journey ended",
                        "enum": ["submitted", "selections_removed", "new_chat", "chat_cleared", "session_expired"]
                    },
                    "submission.action": {
                        "type": "string",
                        "description": "What the user asked for. 'prompt' when they typed their own question rather than picking a suggestion",
                        "enum": ["prompt", "summarize", "translate"]
                    },
                    "selection.max_count_bucketed": {
                        "type": "string",
                        "description": "Bucketed high-water mark of selections attached during the journey",
                        "enum": ["1", "2", "3-5"]
                    },
                    "interaction.dismissal_count_bucketed": {
                        "type": "string",
                        "description": "Bucketed number of times the user dismissed the Duck.ai surface before the journey ended",
                        "enum": ["0", "1", "2+"]
                    },
                    "interaction.dismissed_before_submission": {
                        "type": "boolean",
                        "description": "Whether the user dismissed the Duck.ai surface at least once during the journey"
                    },
                    "interaction.saw_selection_suggestions": {
                        "type": "boolean",
                        "description": "Whether suggested prompts for the attached selections were shown"
                    },
                    "latency.journey_duration_ms_bucketed": {
                        "type": "string",
                        "description": "Bucketed time from the first selection being attached to the journey ending"
                    }
                }
            }
        }
    }
}
