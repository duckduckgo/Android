// Duck Player buffering hold instrumentation. Documents only the buffering-hold-removed
// pixel added with the buffering feedback work; the older duckplayer_* pixels are not yet backfilled here.
{
    "duckplayer_buffering_hold_removed": {
        "description": "Fires when the Duck Player buffering hold (poster + spinner shown while the YouTube player buffers) is removed, reporting why it ended and how long it lasted. Used to tune the give-up timeout and to spot holds that never resolve on their own.",
        "owners": ["CrisBarreiro"],
        "triggers": ["other"],
        "parameters": [
            "appVersion",
            {
                "key": "reason",
                "type": "string",
                "description": "Why the hold was removed: the first video frame arrived, the video errored, the give-up timer elapsed, the user tapped to dismiss, or the overlay was torn down (e.g. the remember:true opt-out re-created the overlay).",
                "enum": ["frame", "error", "gave_up", "tap", "torn_down"]
            },
            {
                "key": "duration",
                "type": "string",
                "description": "Bucketed hold lifetime in seconds, coarse enough to see the median and tail without carrying a per-session timing fingerprint.",
                "enum": ["0-1", "1-3", "3-10", "10-20", "20-30", "30+"]
            }
        ],
        "expires": "2027-04-30"
    }
}
