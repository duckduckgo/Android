{
    "m_aichat_usage_warning_approaching_shown": {
        "description": "Fires when the approaching-limit card appears under the Duck.ai input. One per appearance: refocusing the input reports again, a refresh that only fills in the card's CTA does not.",
        "owners": ["YoussefKeyrouz"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "form_factor"],
        "parameters": [
            "appVersion",
            "unifiedInputSurface",
            { "key": "window", "type": "string", "description": "Which allowance the message was about.", "enum": ["daily", "weekly"] },
            {
                "key": "percent_bucket",
                "type": "string",
                "description": "The rung of the approaching ladder the card was shown at.",
                "enum": ["50", "75", "90"]
            }
        ]
    },
    "m_aichat_usage_warning_approaching_dismissed": {
        "description": "Fires when the user closes the approaching-limit card with its close button. Not a terminal outcome: a prompt sent afterwards in the same input session is still reported against this exposure.",
        "owners": ["YoussefKeyrouz"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "form_factor"],
        "parameters": [
            "appVersion",
            "unifiedInputSurface",
            { "key": "window", "type": "string", "description": "Which allowance the message was about.", "enum": ["daily", "weekly"] },
            {
                "key": "percent_bucket",
                "type": "string",
                "description": "The rung of the approaching ladder the card was shown at.",
                "enum": ["50", "75", "90"]
            }
        ]
    },
    "m_aichat_usage_warning_approaching_prompt_submitted": {
        "description": "Fires for the first prompt the user sends after seeing the approaching-limit card, in the same input session. Once per exposure.",
        "owners": ["YoussefKeyrouz"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "form_factor"],
        "parameters": [
            "appVersion",
            "unifiedInputSurface",
            { "key": "window", "type": "string", "description": "Which allowance the message was about.", "enum": ["daily", "weekly"] },
            {
                "key": "percent_bucket",
                "type": "string",
                "description": "The rung of the approaching ladder the card was shown at.",
                "enum": ["50", "75", "90"]
            }
        ]
    },
    "m_aichat_usage_warning_approaching_model_switched": {
        "description": "Fires when the user changes model themselves after seeing the approaching-limit card, in the same input session. Once per exposure, never for the switch the card's own CTA performs.",
        "owners": ["YoussefKeyrouz"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "form_factor"],
        "parameters": [
            "appVersion",
            "unifiedInputSurface",
            { "key": "window", "type": "string", "description": "Which allowance the message was about.", "enum": ["daily", "weekly"] },
            {
                "key": "percent_bucket",
                "type": "string",
                "description": "The rung of the approaching ladder the card was shown at.",
                "enum": ["50", "75", "90"]
            }
        ]
    },
    "m_aichat_usage_warning_approaching_abandoned": {
        "description": "Fires when an approaching-limit card's exposure ends with no follow-through (no prompt, no model change, no CTA taken): the input session ends, or a different card replaces it on screen, for example the rung moving from 50 to 75 because of a prompt sent elsewhere.",
        "owners": ["YoussefKeyrouz"],
        "triggers": ["other"],
        "suffixes": ["first_daily_count", "form_factor"],
        "parameters": [
            "appVersion",
            "unifiedInputSurface",
            { "key": "window", "type": "string", "description": "Which allowance the message was about.", "enum": ["daily", "weekly"] },
            {
                "key": "percent_bucket",
                "type": "string",
                "description": "The rung of the approaching ladder the card was shown at.",
                "enum": ["50", "75", "90"]
            }
        ]
    },
    "m_aichat_usage_warning_limit_reached_shown": {
        "description": "Fires when the limit-reached card appears under the Duck.ai input. One per appearance.",
