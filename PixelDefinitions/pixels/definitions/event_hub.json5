    "webTelemetry_brokenImages_day": {
        "description": "Daily bucketed counts of page loads where two or more broken images rendered at 16 × 16 px or more, or one when one in ten or more of the page's images broke, excluding declared tracking pixels, one parameter per broken image count bucket and per broken image share bucket. Fired by the eventHub feature at the end of each 1-day measurement period.",
        "owners": ["GuiltyDolphin"],
        "triggers": ["other"],
        "suffixes": ["form_factor"],
        "parameters": [
            "appVersion",
