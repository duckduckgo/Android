{
    "webTelemetry_adwalls_day": {
        "description": "Daily bucketed count of adwall detections across all pages. Fired by the eventHub feature at the end of each 1-day measurement period.",
        "owners": ["GuiltyDolphin"],
        "triggers": ["other"],
        "suffixes": ["form_factor"],
        "parameters": ["appVersion", "eventHubAdwallCount", "eventHubAttributionPeriod"]
    },
    "webTelemetry_adwalls_week": {
        "description": "Weekly bucketed count of adwall detections across all pages. Fired by the eventHub feature at the end of each 7-day measurement period.",
        "owners": ["GuiltyDolphin"],
        "triggers": ["other"],
        "suffixes": ["form_factor"],
        "parameters": ["appVersion", "eventHubAdwallCount", "eventHubAttributionPeriod"]
    },
