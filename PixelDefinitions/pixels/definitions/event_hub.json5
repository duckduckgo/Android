                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            {
                "keyPattern": "^bareForbidden_status[A-Za-z0-9]+$",
                "type": "string",
                "description": "Bucketed count of detected page loads in the period, per response status, for a title or heading starting \"Forbidden\", bucket. The key is `bareForbidden_status` followed by the bucket name in remote config. Bucket boundaries are set by the eventHub remote config",
