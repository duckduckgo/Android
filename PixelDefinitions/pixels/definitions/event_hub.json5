    // One pixel carries every YouTube interference signal, one parameter per signal.
    "webTelemetry_youtubeInterference_day": {
        "description": "Daily bucketed counts of YouTube interference detections, one parameter per signal. Fired by the eventHub feature at the end of each 1-day measurement period.",
        "owners": ["GuiltyDolphin"],
        "triggers": ["other"],
        "suffixes": ["form_factor"],
        "parameters": [
            "appVersion",
            "eventHubYoutubeVideoAdCount",
            "eventHubYoutubeStaticAdCount",
            "eventHubYoutubePlayabilityErrorCount",
            "eventHubYoutubeAdBlockerCount",
            "eventHubYoutubeBufferingCount",
            "eventHubAttributionPeriod"
        ]
    },
    "webTelemetry_pageLoadTime_day": {
        "description": "Daily bucketed counts of page loads where a load ended 8 s or more after navigation start, or was still loading at 15 s, on a page visible through the load that painted no content under 3 s, one parameter per load time bucket, and one for reloaded pages. Fired by the eventHub feature at the end of each 1-day measurement period.",
        "owners": ["GuiltyDolphin"],
        "triggers": ["other"],
        "suffixes": ["form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "loadLoading",
                "type": "string",
                "description": "Bucketed count of detected page loads in the period where the page was still loading at 15 s. Bucket boundaries are set by the eventHub remote config",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            {
                "key": "load8to15s",
                "type": "string",
                "description": "Bucketed count of detected page loads in the period where the load ended 8 to 15 s after navigation start. Bucket boundaries are set by the eventHub remote config",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            {
                "key": "load15sPlus",
                "type": "string",
                "description": "Bucketed count of detected page loads in the period where the load ended 15 s or more after navigation start. Bucket boundaries are set by the eventHub remote config",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            {
                "key": "slowReload",
                "type": "string",
                "description": "Bucketed count of detected page loads in the period where the slow page was one the user reloaded. Bucket boundaries are set by the eventHub remote config",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            "eventHubAttributionPeriod"
        ]
    },
    "webTelemetry_errorPhraseCount_day": {
        "description": "Daily bucketed counts of page loads where \"access denied\", \"page not found\" or \"404 not found\" was found in rendered text, one parameter per occurrence count bucket. Fired by the eventHub feature at the end of each 1-day measurement period.",
        "owners": ["GuiltyDolphin"],
        "triggers": ["other"],
        "suffixes": ["form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "count1",
                "type": "string",
                "description": "Bucketed count of detected page loads in the period where the phrases occurred once. Bucket boundaries are set by the eventHub remote config",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            {
                "key": "count2to4",
                "type": "string",
                "description": "Bucketed count of detected page loads in the period where the phrases occurred 2 to 4 times. Bucket boundaries are set by the eventHub remote config",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            {
                "key": "count5Plus",
                "type": "string",
                "description": "Bucketed count of detected page loads in the period where the phrases occurred 5 or more times. Bucket boundaries are set by the eventHub remote config",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            "eventHubAttributionPeriod"
        ]
    },
    "webTelemetry_soft404Features_day": {
        "description": "Daily bucketed counts of page loads where five or more error terms were found on a page with little rendered text for its size, fewer than two images or a short title, and under 2000 characters of rendered text, one parameter per error term count bucket. Fired by the eventHub feature at the end of each 1-day measurement period.",
        "owners": ["GuiltyDolphin"],
        "triggers": ["other"],
        "suffixes": ["form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "keywords5to9",
                "type": "string",
                "description": "Bucketed count of detected page loads in the period where the page had 5 to 9 error terms. Bucket boundaries are set by the eventHub remote config",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            {
                "key": "keywords10to24",
                "type": "string",
                "description": "Bucketed count of detected page loads in the period where the page had 10 to 24 error terms. Bucket boundaries are set by the eventHub remote config",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            {
                "key": "keywords25Plus",
                "type": "string",
                "description": "Bucketed count of detected page loads in the period where the page had 25 or more error terms. Bucket boundaries are set by the eventHub remote config",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            "eventHubAttributionPeriod"
        ]
    },
