    "webTelemetry_forbiddenPage_day": {
        "description": "Daily bucketed counts of page loads detected as an access-forbidden error page, one parameter per detection route and response status bucket. The webDetection remote config sets the detection conditions. Fired by the eventHub feature at the end of each 1-day measurement period.",
        "owners": ["GuiltyDolphin"],
        "triggers": ["other"],
        "suffixes": ["form_factor"],
        "parameters": [
            "appVersion",
            {
                "keyPattern": "^wording_status[A-Za-z0-9_-]+$",
                "type": "string",
                "description": "Count of detected page loads in the period, per response status, on the `wording` detection route, bucket. The key is `wording_status` followed by the bucket name. The webDetection remote config sets the buckets in the key, and the eventHub remote config sets the count buckets in the value",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            {
                "keyPattern": "^bareForbidden_status[A-Za-z0-9_-]+$",
                "type": "string",
                "description": "Count of detected page loads in the period, per response status, on the `bareForbidden` detection route, bucket. The key is `bareForbidden_status` followed by the bucket name. The webDetection remote config sets the buckets in the key, and the eventHub remote config sets the count buckets in the value",
                "pattern": "^\\d+(-\\d+|\\+)?$"
            },
            "eventHubAttributionPeriod"
        ]
