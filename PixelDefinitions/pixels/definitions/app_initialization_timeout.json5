{
    "timeout_waiting_for_referrer": {
        "description": "Referrer data was not obtained in time",
        "owners": ["CDRussell"],
        "triggers": ["other"],
        "suffixes": ["form_factor"],
        "parameters": ["appVersion"]
    },
    "timeout_atb_pre_initializer_plugin": {
        "description": "A pre-ATB initialization plugin timed out",
        "owners": ["CDRussell"],
        "triggers": ["other"],
        "suffixes": ["form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "plugin",
                "description": "The class name of the plugin which timed out",
                "type": "string",
                "enum": [
                    "AuraExperimentManager",
                    "EmptyReferrerStateListener",
                    "PlayStoreAppReferrerStateListener",
                    "ReinstallAtbListener",
                    "SamsungStoreInstallAttribution"
                ]
            }
        ]
    },
    "atb_reinstall_check_slow": {
        "description": "The reinstall check before the first ATB call took longer than its 1.5s time limit. The check still finishes and the ATB waits for it. Fires at most once per install, because the check only runs on the first ATB setup. returning_user is the check's answer, not whether the ru variant was applied: a reinstaller with a protected experiment variant keeps that variant. timeout_atb_pre_initializer_plugin with plugin=ReinstallAtbListener can fire for the same event, but only when the step suspended: on Android 11 and later when it had to wait for another caller's check, and on Android 10 and older whenever the Block Store read takes longer than the time limit. When the step only blocks, it is not sent. On Android 10 and older this pixel only fires since reinstall detection there uses Block Store; before that the check returned straight away",
        "owners": ["anikiki"],
        "triggers": ["feature_lifecycle"],
        "suffixes": ["form_factor"],
        "parameters": [
            "appVersion",
            "returningUser",
            {
                "key": "duration",
                "description": "How long the reinstall step took, in seconds",
                "type": "string",
                "enum": ["1.5-3", "3-5", "5-10", "10-30", "30+"]
            }
        ],
        "expires": "2027-04-30"
    },
    "atb_reinstall_check_block_store": {
        "description": "The reinstall check on Android 10 and older finished reading the Block Store \"install seen\" flag. Sent once per install, only on Android 10 and older, where reinstalls are detected with Block Store instead of the Downloads folder. Shows whether detection works there: Block Store only keeps the flag through an uninstall when the device has Android backup turned on. Any result other than found counts the install as new",
        "owners": ["anikiki"],
        "triggers": ["feature_lifecycle"],
        "suffixes": ["form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "result",
                "description": "found: flag found, so the install is a reinstall. not_found: no flag, so a new install, or the flag didn't survive the uninstall. unavailable: Play services isn't available. timeout: Block Store didn't answer within the time limit. error: the read failed",
                "type": "string",
                "enum": ["found", "not_found", "unavailable", "timeout", "error"]
            }
        ],
        "expires": "2027-04-30"
    }
}
