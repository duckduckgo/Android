{
    "timeout_waiting_for_referrer": {
        "description": "Referrer data was not obtained in time",
        "owners": ["CDRussell"],
        "triggers": ["other"],
        "suffixes": ["form_factor"],
        "parameters": ["appVersion"]
    },
    "timeout_atb_pre_initializer_plugin": {
        "description": "A pre-ATB initialization plugin timed out. For plugin=ReinstallAtbListener the step is not cut short: it finishes, still applies the ru variant for a returning user, and the ATB waits for it, so this is sent afterwards and means the step was slow, not that ru was lost",
        "owners": ["CDRussell"],
        "triggers": ["other"],
        "suffixes": ["form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "plugin",
                "description": "The class name of the plugin which timed out",
                "type": "string",
                "enum": [
                    "AuraExperimentManager",
                    "EmptyReferrerStateListener",
                    "PlayStoreAppReferrerStateListener",
                    "ReinstallAtbListener",
                    "SamsungStoreInstallAttribution"
                ]
            }
        ]
    },
    "atb_reinstall_check_slow": {
        "description": "The reinstall step before the first ATB call made the ATB wait longer than its 1.5s time limit. The step still finishes and the ATB waits for it. This measures the ATB's wait, not the reinstall check itself: the check can already have been started by another caller (e.g. onboarding), so it can take longer than this wait. Sent once per install. With ru_applied=true it counts returning users who now get the ru variant but would have lost it before the reinstall step was made non-cancellable: when the ATB waited past the limit, no answer was saved yet, and the old step ran its own full check, which took at least as long. It is a lower bound, because it misses checks that were already partly done when the ATB asked. timeout_atb_pre_initializer_plugin with plugin=ReinstallAtbListener is sent for the same event. On Android 10 and older it only fires since reinstall detection there uses Block Store, and there ru_applied=true is a reinstall that was never detected before, not one the step used to drop",
        "owners": ["anikiki"],
        "triggers": ["feature_lifecycle"],
        "suffixes": ["form_factor"],
        "parameters": [
            "appVersion",
            "returningUser",
            {
                "key": "ru_applied",
                "description": "Whether the ru variant was applied. False for a new user, and for a returning user whose protected experiment variant was kept",
                "type": "boolean"
            },
            {
                "key": "duration",
                "description": "How long the ATB waited for the reinstall step, in seconds",
                "type": "string",
                "enum": ["1.5-3", "3-5", "5-10", "10-30", "30+"]
            }
        ],
        "expires": "2027-04-30"
    },
    "atb_reinstall_check_block_store": {
        "description": "The reinstall check on Android 10 and older finished reading the Block Store \"install seen\" flag. Sent once per install, only on Android 10 and older, where reinstalls are detected with Block Store instead of the Downloads folder. Shows whether detection works there: Block Store only keeps the flag through an uninstall when the device has Android backup turned on. Any result other than found counts the install as new",
        "owners": ["anikiki"],
        "triggers": ["feature_lifecycle"],
        "suffixes": ["form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "result",
                "description": "found: flag found, so the install is a reinstall. not_found: no flag, so a new install, or the flag didn't survive the uninstall. unavailable: Play services isn't available. timeout: Block Store didn't answer within the time limit. error: the read failed",
                "type": "string",
                "enum": ["found", "not_found", "unavailable", "timeout", "error"]
            }
        ],
        "expires": "2027-04-30"
    }
}
