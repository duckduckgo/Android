{
    "sync_device_activity_screen_shown": {
        "description": "Fired each time the Device Activity screen opens, from the Device Activity row in Sync & Backup settings, the new synced device banner or the new synced device notification",
        "owners": ["CDRussell"],
        "triggers": ["user_interaction"],
        "suffixes": ["form_factor"],
        "parameters": ["appVersion"]
    },
    "sync_audit_log_fetch_error": {
        "description": "Fired daily when reading the Sync login audit log fails, while checking for new logins after a sync or while loading a page of the Device Activity screen. Also fired when fetching the account_info key needed to read the entries fails, and when the server rejects the stored cursor (400)",
        "owners": ["CDRussell"],
        "triggers": ["exception"],
        "suffixes": ["form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "status_code",
                "type": "integer",
                "description": "HTTP status code of the failed request: the audit log request, or the keys request when the account_info key could not be fetched. For example 418 when rate limited, or 400 for a rejected cursor. Omitted when no HTTP response was received, for example with no network connection"
            }
        ]
    },
    "sync_audit_log_unknown_version": {
        "description": "Fired daily when a read of the Sync login audit log has an entry whose envelope version this app does not support, so the entry is skipped",
        "owners": ["CDRussell"],
        "triggers": ["exception"],
        "suffixes": ["form_factor"],
        "parameters": ["appVersion"]
    },
    "sync_audit_log_undecryptable": {
        "description": "Fired daily when the app cannot decrypt the Sync login audit log entries, an entry, or the device details in an entry. The reason parameter carries the first failure of the day",
        "owners": ["CDRussell"],
        "triggers": ["exception"],
        "suffixes": ["form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "reason",
                "type": "string",
                "description": "key_not_found: this device has no usable account_info key. payload_decrypt_error: an entry's payload does not decrypt or is not a valid event. device_info_decrypt_error: a device's info does not decrypt, so another name source is used. legacy_name_type_decrypt_error: a device's legacy name or type does not decrypt, so the device shows as unknown",
                "enum": ["key_not_found", "payload_decrypt_error", "device_info_decrypt_error", "legacy_name_type_decrypt_error"]
            }
        ]
    },
    "sync_device_login_notification_shown": {
        "description": "Fired each time the app posts the new synced device notification because a check of the Sync login audit log found logins from other devices. Not fired when a showing notification is updated without an alert",
        "owners": ["CDRussell"],
        "triggers": ["impression"],
        "suffixes": ["form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "delay_bucket",
                "type": "string",
                "description": "Time from the oldest login found by the check that posted the notification to posting it. Each bucket includes its lower bound and excludes its upper bound. invalid when the delay is negative, for example because of a wrong device clock",
                "enum": ["0-1m", "1-5m", "5-30m", "30m-2h", "2-24h", "24h+", "invalid"]
            }
        ]
    },
    "sync_device_login_notification_disabled": {
        "description": "Fired daily when a check of the Sync login audit log finds logins from other devices, but the notification about them cannot be posted because Notify on New Connections is off in Sync & Backup settings, the notification permission is missing, or the app's notifications or the new synced device channel are turned off",
        "owners": ["CDRussell"],
        "triggers": ["feature_lifecycle"],
        "suffixes": ["form_factor"],
        "parameters": ["appVersion"]
    },
    "sync_device_login_notification_tapped": {
        "description": "Fired each time the user taps the new synced device notification, which opens the Device Activity screen",
        "owners": ["CDRussell"],
        "triggers": ["user_interaction"],
        "suffixes": ["form_factor"],
        "parameters": ["appVersion"]
    },
    "sync_device_login_notification_permission": {
        "description": "Fired daily after a check of the Sync login audit log, for every Sync user, whether or not there are new logins. Reports whether the new synced device notification can be posted",
        "owners": ["CDRussell"],
        "triggers": ["feature_lifecycle"],
        "suffixes": ["form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "state",
                "type": "string",
                "description": "enabled when Notify on New Connections is on in Sync & Backup settings and the system lets the app post the notification (permission granted, app notifications on, channel on). disabled otherwise",
                "enum": ["enabled", "disabled"]
            }
        ]
    }
}
