{
    "sync_setup_scan_qr_screen_shown": {
        "description": "The sync setup scan QR code screen was shown to the user",
        "owners": ["MiSikora"],
        "triggers": ["other"],
        "suffixes": ["form_factor"],
        "parameters": [
            "appVersion",
            {
                "key": "source",
                "type": "string",
                "description": "Which sync setup flow the screen belongs to",
                "enum": ["connect", "exchange"]
            },
            {
                "key": "flow_version",
                "type": "string",
                "description": "Which sync setup protocol stack the device is on (v2 when canUseV2ConnectFlow is enabled, v2.1 when canUseExchangeV2Point1 is also enabled)",
                "enum": ["v1", "v2", "v2.1"]
            },
            {
                "key": "ui_version",
                "type": "string",
                "description": "Which sync setup UI the user is on: always v2 in current app versions; v1 is only sent by older versions that still had the legacy setup screens",
                "enum": ["v1", "v2"]
            },
            {
                "key": "my_kind",
                "type": "string",
                "description": "This device's credential kind. Always ddg for the native client",
                "enum": ["ddg", "3party"]
            }
        ]
    },
    "sync_setup_barcode_screen_shown": {
        "description": "The sync setup barcode (QR) screen was shown to the user",
        "owners": ["CDRussell"],
