          "_comment": "Optional: results render 25 cards and load more by infinite scroll. Scroll the spinner into view and wait up to 10s for card 26; always resolves, so it never fails the scan.",
          "actionType": "executeScript",
          "script": "return new Promise(function (resolve) { try { var list = root.getElementById('persons-list-container'); var spinner = list && list.dataset.hasMore === '1' && list.querySelector('.js-infinity-scroll-spinner'); if (!spinner) return resolve(); spinner.scrollIntoView(); var start = Date.now(); var timer = setInterval(function () { if (root.querySelectorAll('.name-cards-block').length > 25 || Date.now() - start > 10000) { clearInterval(timer); resolve(); } }, 500); } catch (e) { resolve(); } });",
          "id": "429c0a45-732c-4535-ac0c-62ab2d79c21c"
        },
        {
          "actionType": "extract",
          "selector": ".name-cards-block",
          "noResultsSelector": "//div[contains(@class, 'error-content') and contains(., 'We could not find people')]",
