              "findElements": true
            },
            "relativesList": {
              "selector": ".//div[contains(@class, 'rel-icon')]/following-sibling::div[contains(@class, 'name-cards-block__text')]//a",
              "findElements": true
            },
            "profileUrl": {
              "selector": ".//a[contains(@class, 'like-button')]"
            }
          },
          "id": "67b67d1a-99dc-4975-bc45-33475420f410"
