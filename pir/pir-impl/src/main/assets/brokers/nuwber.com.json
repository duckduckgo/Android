{
  "name": "Nuwber",
  "url": "nuwber.com",
  "version": "0.1.0",
  "optOutUrl": "https://nuwber.com/removal/link",
  "steps": [
    {
      "stepType": "scan",
      "scanType": "templatedUrl",
      "actions": [
        {
          "actionType": "navigate",
          "url": "https://nuwber.com/search?name=${firstName}%20${lastName}&location=${city}%2C%20${state}",
          "id": "4aef3faf-c080-4087-907a-5e5a5b1a84c7"
        },
        {
          "actionType": "expectation",
          "_comment": "wait for cloudflare check to pass - we are using a negative xpath selector to ensure the challenge is not being displayed",
          "expectations": [
            {
              "type": "element",
              "selector": "//body[not(.//script[contains(@src, '/cdn-cgi/challenge-platform/')]) and not(.//script[contains(., '_cf_chl_opt')])]"
            }
          ],
          "id": "cfc-cf3a317f-64b6-4b4f-b7d4-b978d54aee6a"
        },
        {
          "actionType": "expectation",
          "expectations": [
            {
              "type": "element",
              "selector": "#search-page"
            }
          ],
          "id": "db899d28-e1a5-4386-b924-e0c895c2f47a"
        },
        {
          "actionType": "condition",
          "_comment": "Close the disclaimer modal",
          "expectations": [
            {
              "type": "element",
              "selector": ".fog-block"
            }
          ],
          "actions": [
            {
              "actionType": "click",
              "elements": [
                {
                  "type": "button",
                  "selector": ".fog-block #fcra-check"
                },
                {
                  "type": "button",
                  "selector": ".fog-block button"
                }
              ],
              "id": "3444b833-1c17-4ac1-9e7d-ab270fed69db"
            }
          ],
          "id": "25acad4f-f9f3-4afd-b0f6-62245c78e69f"
        },
        {
          "actionType": "extract",
          "selector": "//div[@class='result-block']",
          "noResultsSelector": "//h2[contains(text(), 'No results found')] | //*[not(//div[@class='result-block'])]",
          "profile": {
            "name": {
              "selector": ".result-block-head h2 a"
            },
            "addressCityState": {
              "selector": ".result-block-head p"
            },
            "age": {
              "selector": ".result-block-head span",
              "beforeText": "AGE"
            },
            "addressCityStateList": {
              "selector": ".//div[@class='result-block-content-column'][.//span[text()='Previous Locations']]/p/span",
              "findElements": true
            },
            "relativesList": {
              "selector": ".//div[@class='result-block-content-column'][.//span[text()='Relatives']]/p/span",
              "findElements": true
            },
            "profileUrl": {
              "selector": ".result-block-head h2 a"
            }
          },
          "id": "41a0a5c2-c16f-4288-bcf2-620cce1ed9f4"
        }
      ]
    },
