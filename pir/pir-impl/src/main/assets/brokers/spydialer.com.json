              "selector": "//*[@id='ctl00_ContentPlaceHolder1_TotalHitsLabel'] | //span[@id='ctl00_ContentPlaceHolder1_DataMessageLabel' and contains(text(), 'have anything')] | //*[@id='ctl00_ContentPlaceHolder1_OtherDataCityLabel']"
            }
          ],
          "id": "40fabedd-1d1e-4095-abb9-00790e586e77"
        },
        {
          "actionType": "executeScript",
          "_comment": "Age bands such as '50s' only match within a year of their start, so a band that fits the user's age is replaced with it.",
          "script": "var a = parseInt(userProfile.age, 10); function fit(t) { var m = /^(\\d+)(s|\\+)$/.exec((t || '').trim()); if (!m || isNaN(a)) return null; var lo = +m[1], hi = m[2] === '+' ? 1e9 : lo + 9; return a >= lo - 1 && a <= hi + 1 ? String(a) : null; } root.querySelectorAll('#HideWaitMiddleDiv div.section.group div.span_2').forEach(function (e) { var v = fit(e.textContent); if (v) e.textContent = v; });",
          "id": "63cad379-ea2e-4b3e-8b63-6bff67f8ea02"
        },
        {
          "actionType": "extract",
          "selector": "#HideWaitMiddleDiv div.section.group",
          "noResultsSelector": "//span[@id='ctl00_ContentPlaceHolder1_DataMessageLabel' and contains(text(), 'have anything')] | //*[@id='ctl00_ContentPlaceHolder1_OtherDataCityLabel']",
          "profile": {
            "name": {
              "selector": "a.name-display"
            },
            "age": {
              "selector": "div.span_2"
            },
            "addressFull": {
              "selector": "div.span_3"
            },
            "profileUrl": {
              "identifierType": "hash"
            }
          },
          "id": "bd1c5d8b-7647-4967-9535-8542933abfdd"
        }
      ]
