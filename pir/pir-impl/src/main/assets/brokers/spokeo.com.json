  "steps": [
    {
      "stepType": "scan",
      "scanType": "templatedUrl",
      "actions": [
        {
          "actionType": "navigate",
          "id": "1dd21871-1eee-4b1a-8338-fefeab90687f",
          "url": "https://www.spokeo.com/${firstName}-${lastName}/${state|stateFull}/${city}"
        },
        {
          "actionType": "extract",
          "id": "bd52ece4-55ba-4839-8360-a201c99d6ae6",
          "selector": "div[role='listitem']",
          "noResultsSelector": "//div[contains(., 'did not match') and not(descendant::div[contains(., 'did not match')])]",
          "profile": {
            "name": {
              "selector": "h3",
              "beforeText": ","
            },
            "age": {
              "selector": "h3",
              "afterText": ","
            },
            "addressCityState": {
              "selector": ".//div[contains(text(), 'Reside')]",
              "afterText": " IN "
            },
            "addressCityStateList": {
              "selector": ".//span[starts-with(normalize-space(.), 'Location')]/following-sibling::text()[normalize-space()][1]",
              "separator": ","
            },
            "relativesList": {
              "selector": ".//a[preceding-sibling::span[1][starts-with(normalize-space(.), 'Relatives')]]",
              "findElements": true
            },
            "alternativeNamesList": {
              "selector": ".//span[starts-with(normalize-space(.), 'Alias')]/following-sibling::span[1]",
              "separator": ","
            },
            "profileUrl": {
              "selector": "a",
              "identifierType": "path",
              "identifier": "https://www.spokeo.com/${firstName}-${lastName}/${state|stateFull}/${city|hyphenated}/${id}"
            }
          }
        }
      ]
    },
    {
      "stepType": "optOut",
      "optOutType": "formOptOut",
      "actions": [
