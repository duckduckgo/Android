{
  "name": "PeopleSearch",
  "url": "peoplesearch.com",
  "version": "0.3.0",
  "parent": "411.com",
  "addedDatetime": 1790716560795,
  "optOutUrl": "https://whitepagesprivacy.zendesk.com/hc/en-us/requests/new?ticket_form_id=360002296993",
  "steps": [
    {
      "stepType": "scan",
      "scanType": "templatedUrl",
      "actions": [
        {
          "actionType": "navigate",
          "id": "836fcdb0-f5c8-4032-b0e9-86dff2f6abf3",
          "url": "https://peoplesearch.com/search?s_name=${firstName}%20${lastName}&s_loc=${state|upcase}"
        },
        {
          "actionType": "expectation",
          "id": "624b2c4d-9516-4698-a5a9-bb560d004881",
          "expectations": [
            {
              "type": "element",
              "selector": "//span[@class='sr-only'] | //h1[normalize-space(.)='Sorry!']"
            }
          ]
        },
        {
          "actionType": "executeScript",
          "id": "e183e68f-da99-4e54-af9e-3edea3688afd",
          "_comment": "Age bands such as '50s' only match within a year of their start, so a band that fits the user's age is replaced with it.",
          "script": "var a = parseInt(userProfile.age, 10); function fit(t) { var m = /^(\\d+)(s|\\+)$/.exec((t || '').trim()); if (!m || isNaN(a)) return null; var lo = +m[1], hi = m[2] === '+' ? 1e9 : lo + 9; return a >= lo - 1 && a <= hi + 1 ? String(a) : null; } root.querySelectorAll('span.sr-only').forEach(function (e) { e.textContent = e.textContent.replace(/, (\\d+(?:s|\\+)), /, function (w, b) { var v = fit(b); return v ? ', ' + v + ', ' : w; }); });"
        },
        {
          "actionType": "extract",
          "id": "886f93ab-3cfd-446b-ad51-2d0b889b1858",
          "selector": ".shadow-md.rounded-none, .shadow-md.sm\\:rounded-xl",
          "noResultsSelector": "//h1[normalize-space(.)='Sorry!']",
          "_comment": "Card layouts vary. The sr-only summary is the one consistent source.",
          "profile": {
            "name": {
              "selector": ".//span[@class='sr-only']",
              "beforeText": ","
            },
            "age": {
              "selector": ".//span[@class='sr-only']",
              "afterText": "/,\\s*/",
              "beforeText": "/,/"
            },
            "addressCityState": {
              "selector": ".//span[@class='sr-only']",
              "afterText": "/,\\s*(?=[^,]*,[^,]*$)/"
            },
            "profileUrl": {
              "selector": ".//a[contains(@href, '/person/')]"
            }
          }
        }
      ]
    },
    {
      "stepType": "optOut",
      "optOutType": "parentSiteOptOut",
      "actions": []
    }
  ],
  "schedulingConfig": {
    "_comment": "Opt-out removal is manual and takes about three days.",
    "retryError": 48,
    "confirmOptOutScan": 168,
    "maintenanceScan": 120,
    "maxAttempts": -1
  },
  "removedAt": null
}
