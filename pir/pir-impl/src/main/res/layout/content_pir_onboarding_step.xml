<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:parentTag="android.widget.LinearLayout">

    <com.duckduckgo.pir.impl.onboarding.PirFeatureInfoListItemView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/keyline_5"
        app:featureInfoDescription="@string/pirOnboardingStepItem1Description"
        app:featureInfoIcon="@drawable/device_all_24"
        app:featureInfoTitle="@string/pirOnboardingStepItem1Title">

        <com.duckduckgo.pir.impl.onboarding.PirPlatformIconsView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/keyline_2"
            app:platformsVisible="mac|windows" />

    </com.duckduckgo.pir.impl.onboarding.PirFeatureInfoListItemView>

    <com.duckduckgo.pir.impl.onboarding.PirFeatureInfoListItemView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/keyline_4"
        app:featureInfoDescription="@string/pirOnboardingStepItem2Description"
        app:featureInfoIcon="@drawable/reload_16"
        app:featureInfoTitle="@string/pirOnboardingStepItem2Title" />

    <com.duckduckgo.pir.impl.onboarding.PirFeatureInfoListItemView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/keyline_4"
        app:featureInfoDescription="@string/pirOnboardingStepItem3Description"
        app:featureInfoIcon="@drawable/device_laptop_lock_16"
        app:featureInfoTitle="@string/pirOnboardingStepItem3Title" />

    <com.duckduckgo.pir.impl.onboarding.PirFeatureInfoListItemView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/keyline_4"
        app:featureInfoDescription="@string/pirOnboardingStepItem4Description"
        app:featureInfoIcon="@drawable/form_autofill_16"
        app:featureInfoTitle="@string/pirOnboardingStepItem4Title" />

    <com.duckduckgo.pir.impl.onboarding.PirFeatureInfoListItemView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/keyline_4"
        app:featureInfoDescription="@string/pirOnboardingStepItem5Description"
        app:featureInfoIcon="@drawable/support_16"
        app:featureInfoTitle="@string/pirOnboardingStepItem5Title" />

</merge>
